#!/bin/bash
#PBS -N M2_H1_CORR_DC
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=16gb:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -o /scratch/pr21vyci/runs_mode2/02_h1_reference_corrected/M2_H1_datacheck.out
#PBS -e /scratch/pr21vyci/runs_mode2/02_h1_reference_corrected/M2_H1_datacheck.err
#PBS -M pruthviraj.chavan@student.tu-freiberg.de
#PBS -m bea

set -euo pipefail

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch/." >&2
  echo "Please execute from /scratch/pr21vyci/projects/adaptive-remeshing/..." >&2
  exit 88
fi

RUN_DIR="/scratch/pr21vyci/runs_mode2/02_h1_reference_corrected"
cd "$RUN_DIR"

echo "=== M2_H1_CORR_DC STARTED AT $(date) ON $(hostname) ==="
source /etc/profile.d/modules.sh 2>/dev/null || true
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023

echo "=== PRE-RUN INTEGRITY CHECK ==="
sha256sum M2_H1_reference.inp f42_mixed_uel.for > DATACHECK_PRE_RUN_SHA256SUMS
cat DATACHECK_PRE_RUN_SHA256SUMS

echo "=== EXECUTING ABAQUS DATACHECK ==="
abaqus datacheck job=M2_H1_datacheck user=f42_mixed_uel.for input=M2_H1_reference.inp double=both cpus=1 interactive

EXIT_CODE=$?
echo "=== DATACHECK FINISHED WITH EXIT CODE $EXIT_CODE AT $(date) ==="
exit $EXIT_CODE
