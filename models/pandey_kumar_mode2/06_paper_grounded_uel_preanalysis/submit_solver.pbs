#!/bin/bash
#PBS -N M2_J1_UEL_PRE
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=24:00:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o M2_J1_UEL_PRE.out
#PBS -e M2_J1_UEL_PRE.err

set -euo pipefail
cd /home/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode2/06_paper_grounded_uel_preanalysis || exit 1

if [ ! -f ./job_notifications.sh ]; then
  echo "[LAUNCHER ERROR] job_notifications.sh missing" >&2
  exit 10
fi

source ./job_notifications.sh
notification_load_config || true
notification_install_terminal_trap
notify_start || true

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING MODE-II JOB-1_UEL PREANALYSIS SOLVER (1 CPU, Mem: 16GB) ==="
rm -f Job-1_UEL.lck Job-1_UEL.023 uel_energy_balance.csv
abaqus job=Job-1_UEL user=f42_mixed_uel.for input=Job-1_UEL.inp cpus=1 double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED MODE-II JOB-1_UEL PREANALYSIS SOLVER (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
