#!/bin/bash
#PBS -N PK_M1_14K_4T_DC
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=4
#PBS -l mem=16gb
#PBS -l walltime=00:30:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_14K_4T_DATACHECK.out
#PBS -e PK_M1_14K_4T_DATACHECK.err

set -euo pipefail
cd /scratch/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/26_stage14_adaptive_candidate_14k_4thread || exit 1

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch/." >&2
  echo "Please execute from /scratch/pr21vyci/projects/adaptive-remeshing/..." >&2
  exit 88
fi

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING DATACHECK PK_M1_14K_4T_STAGE_A (4 Threads) ==="
rm -f PK_M1_14K_4T_STAGE_A.lck PK_M1_14K_4T_STAGE_A.023
abaqus datacheck job=PK_M1_14K_4T_STAGE_A user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE.inp cpus=4 mp_mode=threads memory="16gb" double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED DATACHECK PK_M1_14K_4T_STAGE_A (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
