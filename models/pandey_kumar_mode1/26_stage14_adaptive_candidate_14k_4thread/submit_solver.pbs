#!/bin/bash
#PBS -N PK_M1_14K_4T
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=4
#PBS -l mem=16gb
#PBS -l walltime=12:00:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_14K_4T_STAGE_A.out
#PBS -e PK_M1_14K_4T_STAGE_A.err

set -euo pipefail
cd /home/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/26_stage14_adaptive_candidate_14k_4thread || exit 1

if [ ! -f ./job_notifications.sh ]; then
  echo "[LAUNCHER ERROR] job_notifications.sh missing" >&2
  exit 10
fi

source ./job_notifications.sh
notification_load_config || true
notification_install_terminal_trap
notify_start || true

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING 4-THREAD SOLVER PK_M1_14K_4T_STAGE_A (CPUs: 4, mp_mode=threads, Mem: 16GB) ==="
rm -f PK_M1_14K_4T_STAGE_A.lck PK_M1_14K_4T_STAGE_A.023 uel_energy_balance.csv
abaqus job=PK_M1_14K_4T_STAGE_A user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE.inp cpus=4 mp_mode=threads memory="16gb" double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED 4-THREAD SOLVER PK_M1_14K_4T_STAGE_A (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
