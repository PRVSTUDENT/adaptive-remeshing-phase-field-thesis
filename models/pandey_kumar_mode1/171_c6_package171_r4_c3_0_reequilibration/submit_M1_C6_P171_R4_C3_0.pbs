#!/bin/bash
#PBS -N M1_C6_P171_R4_C3_0
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=08:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/mode1_c6_package171_r4_c3_0_reequilibration/pbs_execution.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
RUN_DIR="/scratch9/pr21vyci/runs/mode1_c6_package171_r4_c3_0_reequilibration"
cd "${RUN_DIR}"

export JOB_NAME="M1_C6_P171_R4_C3_0"
export NOTIFICATION_CONFIG="${NOTIFICATION_CONFIG:-${HOME}/.config/adaptive-remeshing/notifications.env}"
source "${RUN_DIR}/job_notifications.sh"
notification_load_config
notification_install_terminal_trap
notify_start

if ! type module >/dev/null 2>&1; then
    source /etc/profile.d/lmod.sh 2>/dev/null || source /usr/share/Modules/init/bash 2>/dev/null || true
fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v ifort

repo="${RUN_DIR}/runtime"
python3 "${repo}/scripts/state_transfer/driver_package171_r4_c6_coupled_pdas.py" \
    --package "${RUN_DIR}" \
    --output "${RUN_DIR}/equilibration_${PBS_JOBID}" \
    --extractor "${repo}/scripts/validation/extract_package148_iteration.py" \
    --memory-gb 16 \
    --timeout 25200 \
    --max-outer 100 \
    --damping-omega-d 0.5
EXIT_CODE=$?

echo "Stage C3-0 Re-equilibration (Package 171-R4 C6 Coupled PDAS Damped omega_d = 0.5) finished with exit code: ${EXIT_CODE}"
exit ${EXIT_CODE}
