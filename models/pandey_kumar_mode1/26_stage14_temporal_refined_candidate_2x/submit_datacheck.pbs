#!/bin/bash
#PBS -N PK_M1_14K_T2X_DC
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=00:30:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_14K_TEMPORAL_2X_DATACHECK.out
#PBS -e PK_M1_14K_TEMPORAL_2X_DATACHECK.err

set -euo pipefail
cd /scratch/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/26_stage14_temporal_refined_candidate_2x || exit 1

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch/." >&2
  echo "Please execute from /scratch/pr21vyci/projects/adaptive-remeshing/..." >&2
  exit 88
fi

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING DATACHECK PK_M1_14K_TEMPORAL_2X_DATACHECK ==="
rm -f PK_M1_14K_TEMPORAL_2X_DATACHECK.lck PK_M1_14K_TEMPORAL_2X_DATACHECK.023
abaqus datacheck job=PK_M1_14K_TEMPORAL_2X_DATACHECK user=f42_mixed_uel.for input=PK_M1_14K_TEMPORAL_2X_DATACHECK.inp cpus=1 interactive
ABAQUS_EXIT=$?
echo "=== FINISHED DATACHECK PK_M1_14K_TEMPORAL_2X_DATACHECK (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
