#!/bin/bash
#PBS -N PK_M1_ADAPT_14K_T2X
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=24:00:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X.out
#PBS -e PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X.err

set -euo pipefail
cd /home/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/26_stage14_temporal_refined_candidate_2x || exit 1

if [ ! -f ./job_notifications.sh ]; then
  echo "[LAUNCHER ERROR] job_notifications.sh missing" >&2
  exit 10
fi

source ./job_notifications.sh
notification_load_config || true
notification_install_terminal_trap
notify_start || true

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING SOLVER PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X ==="
rm -f PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X.lck PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X.023
abaqus job=PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X.inp cpus=1 memory="16gb" double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED SOLVER PK_MODE1_STAGE14_ADAPT_14K_TEMPORAL_2X (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
