*STEP, NAME=Step-1, NLGEOM=NO, INC=10000
*STATIC
0.02, 1.0, 1.0e-7, 0.02
*BOUNDARY
N_LOWER_HOLE, 1, 2, 0.0
N_UPPER_HOLE, 1, 1, 0.0
N_RP, 2, 2, 0.0500
*RESTART, WRITE, FREQUENCY=1
*OUTPUT, FIELD, FREQUENCY=1
*NODE OUTPUT, NSET=N_RP
U, RF
*ELEMENT OUTPUT, ELSET=umatelem
MISESERI, MISESAVG, S, E, SDV
*NODE PRINT, FREQ=1, NSET=N_RP
U2, RF2
*END STEP
** ----------------------------------------------------------
** STEP 2: Fracture Propagation to u = 1.5000 mm
** ----------------------------------------------------------
*STEP, NAME=Step-2, NLGEOM=NO, INC=20000
*STATIC
0.002, 1.0, 1.0e-8, 0.002
*BOUNDARY
N_RP, 2, 2, 1.5000
*RESTART, WRITE, FREQUENCY=1
*OUTPUT, FIELD, FREQUENCY=1
*NODE OUTPUT, NSET=N_RP
U, RF
*ELEMENT OUTPUT, ELSET=umatelem
MISESERI, MISESAVG, S, E, SDV
*NODE PRINT, FREQ=1, NSET=N_RP
U2, RF2
*END STEP
