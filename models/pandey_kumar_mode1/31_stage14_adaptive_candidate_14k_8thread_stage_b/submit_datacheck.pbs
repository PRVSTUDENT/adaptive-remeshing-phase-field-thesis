#!/bin/bash
#PBS -N PK_M1_14K_8T_B_DC
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=8
#PBS -l mem=16gb
#PBS -l walltime=00:30:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_14K_8T_B_DC.out
#PBS -e PK_M1_14K_8T_B_DC.err

set -euo pipefail
cd /scratch/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/31_stage14_adaptive_candidate_14k_8thread_stage_b || exit 1

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch/." >&2
  echo "Please execute from /scratch/pr21vyci/projects/adaptive-remeshing/..." >&2
  exit 88
fi

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING PBS DATACHECK PK_M1_14K_8T_STAGE_B_DATACHECK ==="
rm -f PK_M1_14K_8T_STAGE_B_DATACHECK.*
abaqus job=PK_M1_14K_8T_STAGE_B_DATACHECK user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE.inp cpus=8 mp_mode=threads datacheck interactive
DC_EXIT=$?
echo "=== PBS DATACHECK COMPLETED WITH EXIT: $DC_EXIT ==="
exit "$DC_EXIT"
