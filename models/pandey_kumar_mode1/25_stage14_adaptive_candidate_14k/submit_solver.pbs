#!/bin/bash
#PBS -N PK_M1_ADAPT_14K_FRACTURE
#PBS -q normal_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=12:00:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_ADAPT_14K_FRACTURE.out
#PBS -e PK_M1_ADAPT_14K_FRACTURE.err

set -euo pipefail
cd /home/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/25_stage14_adaptive_candidate_14k || exit 1

if [ ! -f ./job_notifications.sh ]; then
  echo "[LAUNCHER ERROR] job_notifications.sh missing" >&2
  exit 10
fi

source ./job_notifications.sh
notification_load_config || true
notification_install_terminal_trap
notify_start || true

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING SOLVER PK_M1_ADAPT_14K_FRACTURE (1 CPU SERIAL, 14,483 FINITE ELEMENTS) ==="
rm -f PK_M1_ADAPT_14K_FRACTURE.lck PK_M1_ADAPT_14K_FRACTURE.023
abaqus job=PK_M1_ADAPT_14K_FRACTURE user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE.inp cpus=1 memory="16gb" double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED SOLVER PK_M1_ADAPT_14K_FRACTURE (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
