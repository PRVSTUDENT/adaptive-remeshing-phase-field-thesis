#!/bin/bash
#PBS -N PK_M1_14K_DATACHECK
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=00:30:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_14K_DATACHECK.out
#PBS -e PK_M1_14K_DATACHECK.err

set -euo pipefail
cd /home/pr21vyci/projects/adaptive-remeshing/models/pandey_kumar_mode1/25_stage14_adaptive_candidate_14k || exit 1

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING DATACHECK PK_M1_14K_DATACHECK ==="
rm -f PK_M1_14K_DATACHECK.lck PK_M1_14K_DATACHECK.023
abaqus datacheck job=PK_M1_14K_DATACHECK user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE.inp cpus=1 interactive
ABAQUS_EXIT=$?
echo "=== FINISHED DATACHECK PK_M1_14K_DATACHECK (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
