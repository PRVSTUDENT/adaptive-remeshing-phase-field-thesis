    },
    "fracture_functional_energy": {
      "symbol": "E_frac",
      "fortran_array": "ENERGY(7)",
      "source_file": "f42_mixed_uel.for",
      "lines": "357-359, 372, 655, 658",
      "definition_latex": "E_{\\text{frac}}(d) = \\int_\\Omega G_c \\left[ \\frac{d^2}{2l_0} + \\frac{l_0}{2} |\\nabla d|^2 \\right] \\mathrm{d}\\Omega",
