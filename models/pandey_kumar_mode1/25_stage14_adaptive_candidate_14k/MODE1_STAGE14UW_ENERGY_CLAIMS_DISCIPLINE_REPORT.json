      "fortran_array": "ENERGY(2)",
      "source_file": "f42_mixed_uel.for",
      "lines": "534-537, 548, 808, 815",
      "definition_latex": "E_{\\text{elas}}(u, d) = \\int_\\Omega \\left[ ((1-d)^2 + k)\\psi_0^+(\\boldsymbol{\\varepsilon}) + \\psi_0^-(\\boldsymbol{\\varepsilon}) \\right] \\mathrm{d}\\Omega",
