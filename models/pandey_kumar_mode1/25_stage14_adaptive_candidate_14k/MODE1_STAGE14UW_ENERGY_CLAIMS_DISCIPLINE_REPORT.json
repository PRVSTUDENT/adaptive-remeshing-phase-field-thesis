    },
    "total_model_energy": {
      "symbol": "E_model",
      "fortran_variable": "TOT_E_INT",
      "source_file": "f42_mixed_uel.for",
      "lines": "137",
      "definition_latex": "E_{\\text{model}} = E_{\\text{elas}} + E_{\\text{frac}}",
      "description": "Total internal model energy computed by user element subroutine (TOT_E_INT = TOT_E_ELAS + TOT_E_FRAC)"
    },
    "external_work": {
      "symbol": "W_ext",
      "definition_latex": "W_{\\text{ext}} = \\int_0^u F(u') \\,\\mathrm{d}u'",
      "numerical_implementation": "Trapezoidal integration over displacement-reaction history"
    },
    "bookkeeping_residual": {
      "symbol": "Delta_book",
      "definition_latex": "\\Delta_{\\text{book}} = W_{\\text{ext}} - E_{\\text{model}}",
      "description": "Numerical bookkeeping residual arising from discretization, penalty residual k, and discrete incremental integration"
    },
    "normalized_bookkeeping_residual": {
      "symbol": "eps_book",
      "definition_latex": "\\varepsilon_{\\text{book}} = \\frac{\\Delta_{\\text{book}}}{W_{\\text{ext}}} \\times 100\\%",
      "description": "Normalized bookkeeping error percentage"
    }
