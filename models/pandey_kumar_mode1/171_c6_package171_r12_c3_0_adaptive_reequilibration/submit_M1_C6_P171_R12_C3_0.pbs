#!/bin/bash
#PBS -N M1_C6_P171_R12_C3_0
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=08:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/mode1_c6_package171_r12_c3_0_adaptive_reequilibration/pbs_execution.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
RUN_DIR="/scratch9/pr21vyci/runs/mode1_c6_package171_r12_c3_0_adaptive_reequilibration"
cd "${RUN_DIR}"

export JOB_NAME="M1_C6_P171_R12_C3_0"
export NOTIFICATION_CONFIG="${NOTIFICATION_CONFIG:-${HOME}/.config/adaptive-remeshing/notifications.env}"
source "${RUN_DIR}/job_notifications.sh"
notification_load_config
notification_install_terminal_trap
notify_start

if ! type module >/dev/null 2>&1; then
    source /etc/profile.d/lmod.sh 2>/dev/null || source /usr/share/Modules/init/bash 2>/dev/null || true
fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v ifort

repo="${RUN_DIR}/runtime"
python3 "${repo}/scripts/state_transfer/driver_package171_r12_c6_coupled_pdas.py" \
    --package "${RUN_DIR}" \
    --output "${RUN_DIR}/equilibration_${PBS_JOBID}" \
    --extractor "${repo}/scripts/validation/extract_package148_iteration.py" \
    --memory-gb 16 \
    --timeout 25200 \
    --max-outer 140 \
    --omega-d-stage1 0.50 \
    --omega-d-stage2 0.85 \
    --omega-u-stage1 1.00 \
    --omega-u-stage2 0.85 \
    --anderson-memory 2 \
    --anderson-beta 0.85 \
    --anderson-reg 1e-6 \
    --anderson-gamma-max 200.0 \
    --anderson-max-step-cap 0.045 \
    --max-active-cardinality 500 \
    --max-symmetric-diff 10 \
    --max-added-nodes 0 \
    --stabilization-window 3 \
    --rollback-factor 1.05 \
    --divergence-factor 1.50 \
    --catastrophic-delta-d-cap 0.05
EXIT_CODE=$?

echo "Stage C3-0 Re-equilibration (Package 171-R12 C6 Coupled PDAS with Gradient-Preserving Isoparametric Bilinear GP Transfer) finished with exit code: ${EXIT_CODE}"
exit ${EXIT_CODE}
