#!/bin/bash
#PBS -N M1_MB_NAT_8TB
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=8
#PBS -l mem=24gb
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -j oe
#PBS -o /scratch9/pr21vyci/runs/mode1_method_b_native_8t_b/pbs_execution.log

set -euo pipefail

RUN_DIR="/scratch9/pr21vyci/runs/mode1_method_b_native_8t_b"
cd "${RUN_DIR}"

# Storage compliance guard
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution inside /home prohibited." >&2
  exit 88
fi

source /etc/profile.d/modules.sh 2>/dev/null || source /usr/share/Modules/init/bash 2>/dev/null || true
module purge || true
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023

if [ -f "${RUN_DIR}/job_notifications.sh" ]; then
    source "${RUN_DIR}/job_notifications.sh"
    notification_load_config || true
    notification_install_terminal_trap
    notify_start || true
fi

echo "=========================================================="
echo "Job Name:       M1_MB_NAT_8TB (Stage B Determinism Repeat)"
echo "PBS Job ID:     ${PBS_JOBID:-LOCAL}"
echo "Node:           $(hostname)"
echo "Start Time:     $(date -Iseconds)"
echo "Working Dir:    ${RUN_DIR}"
echo "CPUs / Mode:    8 CPUs, mp_mode=threads (Shared-Memory SMP)"
echo "Memory:         24 GB"
echo "=========================================================="

rm -f M1_MB_NATIVE_8T_B.lck M1_MB_NATIVE_8T_B.023 uel_energy_balance.csv

abaqus job=M1_MB_NATIVE_8T_B \
       user=f42_mixed_uel.for \
       input=M1_MB_NATIVE_FINAL_1S.inp \
       cpus=8 \
       mp_mode=threads \
       memory="24gb" \
       double=both \
       interactive

EXIT_CODE=$?
echo "=========================================================="
echo "Abaqus Solver Exit Code: ${EXIT_CODE}"
echo "End Time:                $(date -Iseconds)"
echo "=========================================================="

exit ${EXIT_CODE}
