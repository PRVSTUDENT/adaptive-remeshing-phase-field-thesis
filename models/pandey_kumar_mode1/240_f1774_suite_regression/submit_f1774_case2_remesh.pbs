#!/bin/bash
#PBS -N F1774_C2_REMESH
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=01:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/mode1_pk_f1774_regression_batch/case2_off_axis_hole/pbs_execution_case2.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail

# ------------------------------------------------------------
# Per-Case Working Directory Isolation (Resolving F1774-R05)
# ------------------------------------------------------------
ROOT_RUN_DIR="/scratch9/pr21vyci/runs/mode1_pk_f1774_regression_batch"
CASE_DIR="${ROOT_RUN_DIR}/case2_off_axis_hole"
mkdir -p "${CASE_DIR}"
cd "${CASE_DIR}"

export JOB_NAME="F1774_C2_REMESH"
export FRAMEWORK_SCRIPT="reusable_2d_adaptive_framework.py"
export CONFIG_FILE="f1728_case2_off_axis_hole.json"
export DONOR_ODB="PK_HOLE_COMPANION_RECOVERY.odb"
export USER_SUB="f42_mixed_uel.for"

# Authoritative Expected Hashes (Resolving F1774-R03)
export EXPECTED_UEL_SHA="ce8d5edcd2911dcb018bb15275271f874e7ea62b8fb48cf4a8297469a83acdd6"
export EXPECTED_FRAMEWORK_SHA="8d71f38f23867a23c1fc1bf5ec499533a8c75f538b77804ece03b5c668f4be08"
export EXPECTED_CONFIG_SHA="cbabe93faeede807b02d2ef1a4ec225fd20d362081d62433405ad3fd9724c206"
export EXPECTED_DONOR_SHA="a6514fb8c07c3b855bb4ba841fdb20a9ae8a1c887a6e6ad1a397ba34222ab856"

echo "=== PBS Preflight Check for ${JOB_NAME} ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"
hostname

# 1. Duplicate Run and Atomic Directory Lock Guard (Resolving F1774-R01)
LOCK_DIR="${CASE_DIR}/${JOB_NAME}.lock"
if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
    echo "ERROR: Active lock directory ${LOCK_DIR} exists. Aborting duplicate submission."
    exit 1
fi
# Non-recursive, ownership-safe cleanup trap
trap 'rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT

# 2. Storage Capacity Preflight
AVAIL_KB=$(df -k . | awk 'NR==2 {print $4}')
if [ "${AVAIL_KB}" -lt 5242880 ]; then
    echo "ERROR: Insufficient scratch disk space (${AVAIL_KB} KB available). Aborting."
    exit 1
fi
echo "Scratch disk space confirmed: $((AVAIL_KB / 1024 / 1024)) GB available."

# 3. Stage Shared Files into Isolated Case Directory
cp -f "${ROOT_RUN_DIR}/${USER_SUB}" "${CASE_DIR}/${USER_SUB}"
cp -f "${ROOT_RUN_DIR}/${FRAMEWORK_SCRIPT}" "${CASE_DIR}/${FRAMEWORK_SCRIPT}"
cp -f "${ROOT_RUN_DIR}/${CONFIG_FILE}" "${CASE_DIR}/${CONFIG_FILE}"
cp -f "${ROOT_RUN_DIR}/${DONOR_ODB}" "${CASE_DIR}/${DONOR_ODB}"
if [ -f "${ROOT_RUN_DIR}/job_notifications.sh" ]; then
    cp -f "${ROOT_RUN_DIR}/job_notifications.sh" "${CASE_DIR}/job_notifications.sh"
fi

# 4. Fail-Closed Bitwise Hash Verifications (Resolving F1774-R03)
ACTUAL_UEL_SHA=$(sha256sum "${USER_SUB}" | awk '{print $1}')
if [ "${ACTUAL_UEL_SHA}" != "${EXPECTED_UEL_SHA}" ]; then
    echo "ERROR: User subroutine SHA-256 mismatch! Expected ${EXPECTED_UEL_SHA}, got ${ACTUAL_UEL_SHA}"
    exit 1
fi
echo "User subroutine hash verified: ${ACTUAL_UEL_SHA}"

ACTUAL_FRAMEWORK_SHA=$(sha256sum "${FRAMEWORK_SCRIPT}" | awk '{print $1}')
if [ "${ACTUAL_FRAMEWORK_SHA}" != "${EXPECTED_FRAMEWORK_SHA}" ]; then
    echo "ERROR: Framework script SHA-256 mismatch! Expected ${EXPECTED_FRAMEWORK_SHA}, got ${ACTUAL_FRAMEWORK_SHA}"
    exit 1
fi
echo "Framework script hash verified: ${ACTUAL_FRAMEWORK_SHA}"

ACTUAL_CONFIG_SHA=$(sha256sum "${CONFIG_FILE}" | awk '{print $1}')
if [ "${ACTUAL_CONFIG_SHA}" != "${EXPECTED_CONFIG_SHA}" ]; then
    echo "ERROR: Configuration file SHA-256 mismatch! Expected ${EXPECTED_CONFIG_SHA}, got ${ACTUAL_CONFIG_SHA}"
    exit 1
fi
echo "Configuration file hash verified: ${ACTUAL_CONFIG_SHA}"

ACTUAL_DONOR_SHA=$(sha256sum "${DONOR_ODB}" | awk '{print $1}')
if [ "${ACTUAL_DONOR_SHA}" != "${EXPECTED_DONOR_SHA}" ]; then
    echo "ERROR: Donor ODB SHA-256 mismatch! Expected ${EXPECTED_DONOR_SHA}, got ${ACTUAL_DONOR_SHA}"
    exit 1
fi
echo "Donor ODB hash verified: ${ACTUAL_DONOR_SHA}"

# 5. Dual-Channel Notification Integration
export NOTIFICATION_CONFIG="${NOTIFICATION_CONFIG:-${HOME}/.config/adaptive-remeshing/notifications.env}"
if [ -f "${CASE_DIR}/job_notifications.sh" ]; then
    source "${CASE_DIR}/job_notifications.sh"
    notification_load_config || echo "Notice: notification_load_config returned non-zero (non-fatal)"
    notification_install_terminal_trap || echo "Notice: notification_install_terminal_trap returned non-zero (non-fatal)"
    notify_start || echo "Notice: notify_start returned non-zero (non-fatal)"
fi

# 6. Environment and Module Initialization
if ! type module >/dev/null 2>&1; then source /etc/profile.d/lmod.sh; fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v ifort
command -v abaqus

# 7. Execute Abaqus CAE noGUI Remeshing via Unified Reusable Framework
echo "=== Executing Case 2 Headless Adaptive Remesh in Abaqus CAE 2023 ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"

/cluster/application/abaqus/2023/Commands/abaqus cae noGUI="${CASE_DIR}/${FRAMEWORK_SCRIPT}" -- --config "${CASE_DIR}/${CONFIG_FILE}" --run-case --odb "${CASE_DIR}/${DONOR_ODB}" --output-dir "${CASE_DIR}"
REMESH_EXIT_CODE=$?
echo "Abaqus CAE Finished with Exit Code: ${REMESH_EXIT_CODE}"

if [ "${REMESH_EXIT_CODE}" -ne 0 ]; then
    echo "ERROR: Reusable adaptive remeshing script failed with exit code ${REMESH_EXIT_CODE}."
    exit ${REMESH_EXIT_CODE}
fi

# 8. Physical Adapted Mesh Verification
ADAPT_PHYS_MESH="${CASE_DIR}/PK_F1728_CASE_2_ADAPT_PHYS.inp"
if [ ! -f "${ADAPT_PHYS_MESH}" ]; then
    echo "ERROR: Physical adapted mesh not found: ${ADAPT_PHYS_MESH}"
    exit 1
fi
echo "Physical adapted mesh verified: ${ADAPT_PHYS_MESH}"

# 9. Execute Datacheck Verification on Generated Production 3-Layer Deck (Resolving F1774-R04: Fail-Closed)
PROD_DECK="${CASE_DIR}/PK_F1728_CASE_2_PROD.inp"
if [ ! -f "${PROD_DECK}" ]; then
    echo "ERROR: Production deck ${PROD_DECK} was not generated or not present. Aborting."
    exit 1
fi

echo "=== Running Abaqus Datacheck on ${PROD_DECK} ==="
/cluster/application/abaqus/2023/Commands/abaqus datacheck job=PK_F1774_CASE_2_DC input="${PROD_DECK}" user="${CASE_DIR}/${USER_SUB}" interactive
DC_EXIT_CODE=$?
echo "Datacheck Finished with Exit Code: ${DC_EXIT_CODE}"
if [ "${DC_EXIT_CODE}" -ne 0 ]; then
    echo "ERROR: Abaqus datacheck failed with exit code ${DC_EXIT_CODE}."
    exit ${DC_EXIT_CODE}
fi

echo "=== TASK F1774 CASE 2 ADAPTIVE REMESHING COMPLETE (EXIT 0) ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"
