#PBS -m abe
#PBS -o PK_M1_COARSE_FINE_CONT_CHK.out
#PBS -e PK_M1_COARSE_FINE_CONT_CHK.err

set -euo pipefail
cd /scratch9/pr21vyci/runs/mode1_package46_coarse_fine_preanalysis || exit 1

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING DATACHECK PK_M1_COARSE_FINE_CONT ==="
abaqus job=PK_M1_COARSE_FINE_CONT input=PK_M1_COARSE_FINE_CONT.inp datacheck double=both ask_delete=OFF interactive
ABAQUS_EXIT=$?
echo "=== FINISHED DATACHECK PK_M1_COARSE_FINE_CONT (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
