#!/bin/bash
#PBS -N PK_M1_COARSE_FINE_CONT
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=00:30:00
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_COARSE_FINE_CONT.out
#PBS -e PK_M1_COARSE_FINE_CONT.err

set -euo pipefail
cd /scratch9/pr21vyci/runs/mode1_package46_coarse_fine_preanalysis || exit 1

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch9/." >&2
  exit 88
fi

if [ ! -f ./job_notifications.sh ]; then
  echo "[LAUNCHER ERROR] job_notifications.sh missing" >&2
  exit 10
fi

source ./job_notifications.sh
notification_load_config || true
notification_install_terminal_trap
notify_start || true

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING SOLVER PK_M1_COARSE_FINE_CONT ==="
abaqus job=PK_M1_COARSE_FINE_CONT input=PK_M1_COARSE_FINE_CONT.inp double=both ask_delete=OFF interactive
ABAQUS_EXIT=$?
echo "=== FINISHED SOLVER PK_M1_COARSE_FINE_CONT (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
