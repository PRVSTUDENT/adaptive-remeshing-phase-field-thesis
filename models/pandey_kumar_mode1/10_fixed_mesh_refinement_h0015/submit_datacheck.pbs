#!/bin/bash
#PBS -N PK_M1_F_DC
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=00:15:00
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_MODE1_STANDARD_PFM_DC.out
#PBS -e PK_MODE1_STANDARD_PFM_DC.err

set -euo pipefail
cd "$PBS_O_WORKDIR" || exit 1

if [ ! -f "./job_notifications.sh" ]; then
  echo "[LAUNCHER ERROR] job_notifications.sh missing" >&2
  exit 10
fi

source ./job_notifications.sh
notification_load_config || true
notification_install_terminal_trap
notify_start || true

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING DATACHECK PK_MODE1_STANDARD_PFM ==="
abaqus datacheck job=PK_MODE1_STANDARD_PFM user=f42_mixed_uel.for input=PK_MODE1_STANDARD_PFM.inp double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED DATACHECK PK_MODE1_STANDARD_PFM (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
