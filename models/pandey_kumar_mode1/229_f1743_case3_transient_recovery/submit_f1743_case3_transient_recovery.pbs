#!/bin/bash
#PBS -N F1743_C3_COMPANION
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/mode1_pk_f1743_case3_transient_recovery/pbs_execution.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
RUN_DIR="/scratch9/pr21vyci/runs/mode1_pk_f1743_case3_transient_recovery"
cd "${RUN_DIR}"

export JOB_NAME="F1743_C3_COMPANION"
export USER_SUB="f42_mixed_uel.for"
export EXPECTED_UEL_SHA="ce8d5edcd2911dcb018bb15275271f874e7ea62b8fb48cf4a8297469a83acdd6"

echo "=== PBS Preflight Check for ${JOB_NAME} ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"
hostname

# 1. Duplicate Run and Lock Guard
if [ -e "${JOB_NAME}.lck" ]; then
    echo "ERROR: Active lock file ${JOB_NAME}.lck detected. Aborting."
    exit 1
fi
touch "${JOB_NAME}.lck"
trap 'rm -f "${RUN_DIR}/${JOB_NAME}.lck"' EXIT

# 2. Storage Capacity Preflight
AVAIL_KB=$(df -k . | awk 'NR==2 {print $4}')
if [ "${AVAIL_KB}" -lt 5242880 ]; then
    echo "ERROR: Insufficient scratch disk space (${AVAIL_KB} KB available). Aborting."
    exit 1
fi
echo "Scratch disk space confirmed: $((AVAIL_KB / 1024 / 1024)) GB available."

# 3. Bitwise SHA-256 Hash Verification of User Subroutine
ACTUAL_UEL_SHA=$(sha256sum "${USER_SUB}" | awk '{print $1}')
if [ "${ACTUAL_UEL_SHA}" != "${EXPECTED_UEL_SHA}" ]; then
    echo "ERROR: User subroutine SHA-256 mismatch!"
    echo "  Expected: ${EXPECTED_UEL_SHA}"
    echo "  Actual:   ${ACTUAL_UEL_SHA}"
    exit 1
fi
echo "User subroutine hash verified: ${ACTUAL_UEL_SHA}"

# 4. Dual-Channel Notification Integration
export NOTIFICATION_CONFIG="${NOTIFICATION_CONFIG:-${HOME}/.config/adaptive-remeshing/notifications.env}"
if [ -f "${RUN_DIR}/job_notifications.sh" ]; then
    source "${RUN_DIR}/job_notifications.sh"
    notification_load_config || echo "Notice: notification_load_config returned non-zero (non-fatal)"
    notification_install_terminal_trap || echo "Notice: notification_install_terminal_trap returned non-zero (non-fatal)"
    notify_start || echo "Notice: notify_start returned non-zero (non-fatal)"
fi

# 5. Environment and Module Initialization
if ! type module >/dev/null 2>&1; then source /etc/profile.d/lmod.sh; fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v ifort
command -v abaqus

# 6. Execute Bounded Static Companion Linear Elastic Recovery Solves
echo "=== Executing Intermediate Primary-Propagation Companion Solves ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"

SOLVE_TARGETS=("PK_SEC43_COMPANION_T1" "PK_SEC43_COMPANION_T2" "PK_SEC43_COMPANION_T3")

for JOB in "${SOLVE_TARGETS[@]}"; do
    echo "--- Solving ${JOB} ---"
    rm -f "${JOB}.lck" "${JOB}.odb" "${JOB}.sta" "${JOB}.dat" "${JOB}.msg"
    /cluster/application/abaqus/2023/Commands/abaqus job="${JOB}" interactive
    RC=$?
    echo "Solver ${JOB} finished with exit code ${RC}"
    if [ ${RC} -ne 0 ]; then
        echo "ERROR: Job ${JOB} failed with exit code ${RC}!"
        exit ${RC}
    fi
    if [ ! -f "${JOB}.odb" ]; then
        echo "ERROR: Expected ODB ${JOB}.odb not produced!"
        exit 1
    fi
    echo "SUCCESS: Produced ${JOB}.odb ($(stat -c%s "${JOB}.odb") bytes)"
done

# 7. Audit Native MISESERI and Stress Recovery Fields
echo "=== Auditing Native MISESERI and Stress Recovery Fields ==="
/cluster/application/abaqus/2023/Commands/abaqus python "${RUN_DIR}/audit_f1743_companion_fields.py" "${RUN_DIR}" "${RUN_DIR}/f1743_companion_recovery_summary.json"
AUDIT_RC=$?
echo "Companion audit finished with exit code ${AUDIT_RC}"

if [ ${AUDIT_RC} -ne 0 ]; then
    echo "ERROR: Companion audit failed with exit code ${AUDIT_RC}!"
    exit ${AUDIT_RC}
fi

echo "=== All 3 Companion Recovery Checkpoints Solved and Audited Cleanly ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"
exit 0
