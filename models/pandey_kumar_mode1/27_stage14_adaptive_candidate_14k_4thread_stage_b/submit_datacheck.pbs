#!/bin/bash
#PBS -N PK_M1_14K_4T_STAGE_B_DATACHECK
#PBS -l select=1:ncpus=4:mem=16GB
#PBS -l walltime=00:30:00
#PBS -q entry_imfdfkmq
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch/." >&2
  echo "Please execute from /scratch/pr21vyci/projects/adaptive-remeshing/..." >&2
  exit 88
fi
cd "$PBS_O_WORKDIR"

# Source notifications
if [ -f "./job_notifications.sh" ]; then
    source ./job_notifications.sh
    notification_load_config || true
    notification_install_terminal_trap
    notify_start
fi

module load abaqus/2023 || true

rm -rf PK_M1_14K_4T_STAGE_B_DATACHECK.* || true

echo "=== Starting Abaqus 4-Thread Shared-Memory Stage-B Datacheck ==="
abaqus datacheck job=PK_M1_14K_4T_STAGE_B_DATACHECK user=f42_mixed_uel.for input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE.inp cpus=4 mp_mode=threads memory="16gb" double=both interactive

echo "=== Stage-B Datacheck Finished with exit code $? ==="
