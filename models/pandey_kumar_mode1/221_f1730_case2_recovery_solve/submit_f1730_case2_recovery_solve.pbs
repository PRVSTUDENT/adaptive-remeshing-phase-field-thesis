#!/bin/bash
#PBS -N F1730_CASE2_SOLVE
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/f1730_case2_recovery_solve/pbs_execution.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
RUN_DIR="/scratch9/pr21vyci/runs/f1730_case2_recovery_solve"
cd "${RUN_DIR}"

export PBS_JOB_TITLE="F1730_CASE2_SOLVE"
export JOB_NAME="PK_HOLE_COMPANION_RECOVERY"
export INPUT_DECK="PK_HOLE_COMPANION_RECOVERY.inp"
EXPECTED_INP_SHA="0286f591f865e060d3c34482671d8e378916831d3781db17a4e8bc70963e51e0"

echo "=== PBS Preflight Check for ${PBS_JOB_TITLE} ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"
hostname

# 1. Duplicate Run and Lock Guard
if [ -e "${PBS_JOB_TITLE}.lck" ]; then
    echo "ERROR: Active lock file ${PBS_JOB_TITLE}.lck detected. Aborting."
    exit 1
fi

# 2. Storage Capacity and Quota Preflight
AVAIL_KB=$(df -k . | awk 'NR==2 {print $4}')
if [ "${AVAIL_KB}" -lt 5242880 ]; then # at least 5 GB
    echo "ERROR: Insufficient scratch disk space (${AVAIL_KB} KB available). Aborting."
    exit 1
fi
echo "Scratch disk space confirmed: $((AVAIL_KB / 1024 / 1024)) GB available."

# 3. Bitwise SHA-256 Hash Verification of Input Deck
if [ ! -f "${INPUT_DECK}" ]; then
    echo "ERROR: Input deck not found: ${INPUT_DECK}"
    exit 1
fi
ACTUAL_INP_SHA=$(sha256sum "${INPUT_DECK}" | awk '{print $1}')
if [ "${ACTUAL_INP_SHA,,}" != "${EXPECTED_INP_SHA,,}" ]; then
    echo "ERROR: Input deck SHA-256 mismatch!"
    echo "  Expected: ${EXPECTED_INP_SHA}"
    echo "  Actual:   ${ACTUAL_INP_SHA}"
    exit 1
fi
echo "Input deck hash verified: ${ACTUAL_INP_SHA}"

# 4. Dual-Channel Notification Integration
export NOTIFICATION_CONFIG="${NOTIFICATION_CONFIG:-${HOME}/.config/adaptive-remeshing/notifications.env}"
if [ -f "${RUN_DIR}/job_notifications.sh" ]; then
    source "${RUN_DIR}/job_notifications.sh"
    notification_load_config || echo "Notice: notification_load_config returned non-zero (non-fatal)"
    notification_install_terminal_trap || echo "Notice: notification_install_terminal_trap returned non-zero (non-fatal)"
    notify_start || echo "Notice: notify_start returned non-zero (non-fatal)"
fi

# 5. Environment and Module Initialization
if ! type module >/dev/null 2>&1; then source /etc/profile.d/lmod.sh; fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v abaqus

# 6. Execute Abaqus/Standard Recovery Simulation
echo "=== Running Abaqus/Standard Recovery Solve on ${INPUT_DECK} ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"

# Pure continuum model with 13 isotropic elastic sections; no Fortran user subroutine required
abaqus job="${JOB_NAME}" input="${INPUT_DECK}" interactive
SOLVER_EXIT_CODE=$?
echo "Abaqus Solver Finished with Exit Code: ${SOLVER_EXIT_CODE}"

if [ "${SOLVER_EXIT_CODE}" -ne 0 ]; then
    echo "ERROR: Abaqus solver execution failed with exit code ${SOLVER_EXIT_CODE}."
    if [ -f "${JOB_NAME}.msg" ]; then
        echo "=== Excerpt of ${JOB_NAME}.msg ==="
        tail -n 50 "${JOB_NAME}.msg"
    fi
    exit ${SOLVER_EXIT_CODE}
fi

echo "=== Abaqus Solver Execution Succeeded (Exit Code 0) ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"

# 7. Execute Post-Processing Telemetry Extraction via Abaqus Python
echo "=== Running Telemetry Extraction on ${JOB_NAME}.odb ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"

if [ ! -f "extract_case2_recovery_miseseri.py" ]; then
    echo "ERROR: Extraction script extract_case2_recovery_miseseri.py not found!"
    exit 1
fi

abaqus python extract_case2_recovery_miseseri.py --odb "${JOB_NAME}.odb" --output "f1730_case2_recovery_telemetry.json"
EXTRACT_EXIT_CODE=$?
echo "Extraction Finished with Exit Code: ${EXTRACT_EXIT_CODE}"

if [ "${EXTRACT_EXIT_CODE}" -ne 0 ]; then
    echo "ERROR: Telemetry extraction failed with exit code ${EXTRACT_EXIT_CODE}."
    exit ${EXTRACT_EXIT_CODE}
fi

echo "=== Telemetry Extraction Succeeded (Exit Code 0) ==="
date -u +"%Y-%m-%dT%H:%M:%SZ"

# 8. Print Diagnostic Excerpts
if [ -f "${JOB_NAME}.sta" ]; then
    echo "=== Summary of ${JOB_NAME}.sta ==="
    cat "${JOB_NAME}.sta"
fi
if [ -f "${JOB_NAME}.msg" ]; then
    echo "=== Summary of ${JOB_NAME}.msg ==="
    tail -n 25 "${JOB_NAME}.msg"
fi
if [ -f "${JOB_NAME}.dat" ]; then
    echo "=== SPR Warnings and Diagnostics in ${JOB_NAME}.dat ==="
    grep -E "ERROR|WARNING|ANALYSIS COMPLETE" "${JOB_NAME}.dat" || true
fi

ls -lh
exit 0
