#!/bin/bash
#PBS -N PK_M1_REF15K_ENERGY
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=08:00:00
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
#PBS -o PK_M1_REF15K_ENERGY.out
#PBS -e PK_M1_REF15K_ENERGY.err

set -euo pipefail
cd "$PBS_O_WORKDIR" || exit 1

if [ ! -f ./job_notifications.sh ]; then
  if [ -f "$HOME/projects/adaptive-remeshing/scripts/hpc/notifications/job_notifications.sh" ]; then
    cp "$HOME/projects/adaptive-remeshing/scripts/hpc/notifications/job_notifications.sh" ./job_notifications.sh
  fi
fi

if [ -f ./job_notifications.sh ]; then
  source ./job_notifications.sh
  notification_load_config || true
  notification_install_terminal_trap
  notify_start || true
fi

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING SOLVER PK_M1_REF15K_ENERGY (15,192 Finite Elements, 1-CPU Serial) ==="
rm -f PK_M1_REF15K_ENERGY.lck PK_M1_REF15K_ENERGY.023
abaqus job=PK_M1_REF15K_ENERGY user=f42_mixed_uel.for input=PK_MODE1_REF15K_ENERGY.inp cpus=1 memory="16gb" double=both interactive
ABAQUS_EXIT=$?
echo "=== FINISHED SOLVER PK_M1_REF15K_ENERGY (EXIT: $ABAQUS_EXIT) ==="
exit "$ABAQUS_EXIT"
