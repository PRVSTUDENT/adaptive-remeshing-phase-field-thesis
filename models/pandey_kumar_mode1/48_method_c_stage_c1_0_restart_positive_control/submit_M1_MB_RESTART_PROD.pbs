#!/bin/bash
#PBS -N M1_MB_RST_PROD
#PBS -q entry_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=08:00:00
#PBS -m abe
#PBS -r n
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -j oe
#PBS -o /scratch9/pr21vyci/runs/mode1_package48_restart_control/pbs_execution_restart_prod_recovery1.log

set -euo pipefail

RUN_DIR="/scratch9/pr21vyci/runs/mode1_package48_restart_control"
cd "${RUN_DIR}"

if [[ "$(pwd -P)" =~ ^/home/ ]]; then
    echo "ERROR: Running under /home is strictly prohibited by HPC storage policy." >&2
    exit 2
fi

WORK_DIR="${RUN_DIR}/recovery1_prod"
mkdir -p "${WORK_DIR}"
for suffix in res mdl stt prt odb sim; do
    if [ -f "${RUN_DIR}/M1_MB_DONOR_WITH_RESTART.${suffix}" ]; then
        ln -s "${RUN_DIR}/M1_MB_DONOR_WITH_RESTART.${suffix}" "${WORK_DIR}/M1_MB_DONOR_WITH_RESTART.${suffix}"
    fi
done
cp "${RUN_DIR}/M1_MB_NATIVE_RESTART.inp" "${RUN_DIR}/f42_mixed_uel.for" "${RUN_DIR}/job_notifications.sh" "${WORK_DIR}/"
cd "${WORK_DIR}"
export JOB_NAME="M1_MB_RST_PROD"
if [ -f "./job_notifications.sh" ]; then
    source ./job_notifications.sh
    notification_install_terminal_trap
    notify_start
fi

if ! type module >/dev/null 2>&1; then
    source /etc/profile.d/lmod.sh
fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v ifort
test -s M1_MB_DONOR_WITH_RESTART.res

# Execute native restart continuation using frozen production UEL
# Purpose: Empirically test hypothesis that unmodified UEL experiences COMMON loss on restart
abaqus job=M1_MB_NATIVE_RESTART_PROD oldjob=M1_MB_DONOR_WITH_RESTART input=M1_MB_NATIVE_RESTART.inp user=f42_mixed_uel.for cpus=1 interactive
SOLVER_EXIT=$?

echo "Abaqus native restart (production UEL) completed with exit code: ${SOLVER_EXIT}"
exit ${SOLVER_EXIT}
