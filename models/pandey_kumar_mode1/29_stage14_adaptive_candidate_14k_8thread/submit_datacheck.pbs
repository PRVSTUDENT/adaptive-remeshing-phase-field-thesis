#!/bin/bash
#PBS -N PK_M1_14K_8T_DC
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=8:mem=16gb
#PBS -l walltime=00:30:00
#PBS -q entry_imfdfkmq
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -j oe

# ==============================================================================
# Gate-6B Stage 14U-AL Package 29: 8-Thread Shared-Memory Datacheck Template
# Status: DATACHECK STRICTLY HELD PENDING STAGE-B DETERMINISM PASS
# ==============================================================================

set -eo pipefail

cd "${PBS_O_WORKDIR}"

# STORAGE COMPLIANCE GUARD: Reject execution under /home
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
    echo "[STORAGE COMPLIANCE ERROR] Direct execution in /home filesystem is rejected by storage policy." >&2
    echo "Please execute solver jobs strictly from /scratch/pr21vyci/projects/adaptive-remeshing/ or /scratch9/." >&2
    exit 88
fi


module purge
module load intel/2024.2.0
module load abaqus/2023

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

echo "=== STARTING 8-THREAD SHARED-MEMORY ABAQUS DATACHECK RUN ==="
date

abaqus job=PK_M1_14K_8T_DATACHECK input=PK_MODE1_STAGE14_ADAPT_14K_FRACTURE user=f42_mixed_uel.for datacheck cpus=8 mp_mode=threads double standard interactive > datacheck_execution.log 2>&1
EXIT_CODE=$?

echo "Abaqus datacheck finished with exit code ${EXIT_CODE}"
date
exit ${EXIT_CODE}
