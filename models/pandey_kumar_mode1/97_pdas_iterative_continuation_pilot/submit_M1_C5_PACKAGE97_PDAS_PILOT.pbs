#!/bin/bash
#PBS -N M1_C5_P97_PDAS
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/mode1_package97_c5_pdas_pilot/pbs_execution.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
RUN_DIR="/scratch9/pr21vyci/runs/mode1_package97_c5_pdas_pilot"
cd "${RUN_DIR}"

export NOTIFICATION_CONFIG="${HOME}/.config/adaptive-remeshing/notifications.env"
if [ -f "./job_notifications.sh" ]; then
    source "./job_notifications.sh"
    notification_load_config
    notification_install_terminal_trap
    notify_start "M1_C5_PACKAGE97_PDAS_PILOT" "mode1_package97_c5_pdas_pilot"
fi

if ! type module >/dev/null 2>&1; then
    source /etc/profile.d/lmod.sh 2>/dev/null || source /usr/share/Modules/init/bash 2>/dev/null || true
fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023 python/gcc/11.4.0/3.11.7

command -v ifort

export OMP_NUM_THREADS=1

echo "Starting Iterative PDAS Execution on $(hostname) at $(date)..."

python3 pdas_cluster_execution_adapter.py \
    --seed-deck M1_C5_PACKAGE97_SEED_TRANSFER.inp \
    --mesh-inp candidate_crack_band_mesh_c5.inp \
    --state-table candidate_c5_frame7_mapped_state_table.csv \
    --uel f42_mixed_uel.for \
    --work-dir "${RUN_DIR}" \
    --delta-u-nm 4.0 \
    --k-max 25 \
    --mode cluster_abaqus

EXIT_CODE=$?
echo "Iterative PDAS Pilot finished with exit code ${EXIT_CODE} at $(date)"
exit ${EXIT_CODE}
