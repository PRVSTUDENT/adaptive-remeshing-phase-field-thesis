#!/bin/bash
#PBS -N M1_HIST_TRACE
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=04:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -r n
#PBS -o /scratch9/pr21vyci/runs/mode1_package74_history_call_trace/pbs_execution.log
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
RUN_DIR="/scratch9/pr21vyci/runs/mode1_package74_history_call_trace"
cd "${RUN_DIR}"

export JOB_NAME="M1_F1597_HISTORY_TRACE_R2"
export NOTIFICATION_CONFIG="${NOTIFICATION_CONFIG:-${HOME}/.config/adaptive-remeshing/notifications.env}"
source "${RUN_DIR}/job_notifications.sh"
notification_load_config
source "${RUN_DIR}/trace_notification_receipts.sh"
notification_install_terminal_trap
notify_start

if ! type module >/dev/null 2>&1; then source /etc/profile.d/lmod.sh; fi
module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
command -v ifort

JOB_NAME="M1_F1597_HISTORY_TRACE_R2"
INP_NAME="M1_F1597_HISTORY_TRACE_R2.inp"
USER_SUB="f42_history_trace_uel.for"

test ! -e "${JOB_NAME}.lck"

echo "Starting Abaqus/Standard 2023 Method C Non-invasive History Call Trace Diagnostic..."
abaqus job="${JOB_NAME}" input="${INP_NAME}" user="${USER_SUB}" cpus=1 interactive
EXIT_CODE=$?

echo "Abaqus Finished with Exit Code: ${EXIT_CODE}"
exit ${EXIT_CODE}
