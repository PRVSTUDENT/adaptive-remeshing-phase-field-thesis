#!/bin/bash
#PBS -N M1_MC_GEN_CONT
#PBS -q normal_imfdfkmq
#PBS -l nodes=1:ppn=1
#PBS -l mem=16gb
#PBS -l walltime=04:00:00
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -j oe
#PBS -o /scratch9/pr21vyci/runs/mode1_method_c_genuine_continuation/pbs_execution.log

set -euo pipefail

RUN_DIR="/scratch9/pr21vyci/runs/mode1_method_c_genuine_continuation"
cd "${RUN_DIR}"

# Storage compliance guard
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution inside /home prohibited." >&2
  exit 88
fi

source /etc/profile.d/modules.sh 2>/dev/null || source /usr/share/Modules/init/bash 2>/dev/null || true
module purge || true
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023

if [ -f "${RUN_DIR}/job_notifications.sh" ]; then
    source "${RUN_DIR}/job_notifications.sh"
    notification_load_config || true
    notification_install_terminal_trap
    notify_start || true
fi

echo "=========================================================="
echo "Job Name:       M1_MC_GEN_CONT"
echo "PBS Job ID:     ${PBS_JOBID:-LOCAL}"
echo "Node:           $(hostname)"
echo "Start Time:     $(date -Iseconds)"
echo "Working Dir:    ${RUN_DIR}"
echo "=========================================================="

JOB_NAME="M1_MC_GENUINE_CONTINUATION"
INP_NAME="M1_MC_GENUINE_CONTINUATION.inp"
USER_SUB="f42_mixed_uel.for"

rm -f "${JOB_NAME}.lck" "${JOB_NAME}.023" uel_energy_balance.csv 2>/dev/null || true

abaqus job="${JOB_NAME}" input="${INP_NAME}" user="${USER_SUB}" cpus=1 double=both interactive

EXIT_CODE=$?
echo "=========================================================="
echo "Abaqus Solver Exit Code: ${EXIT_CODE}"
echo "End Time:                $(date -Iseconds)"
echo "=========================================================="

exit ${EXIT_CODE}
