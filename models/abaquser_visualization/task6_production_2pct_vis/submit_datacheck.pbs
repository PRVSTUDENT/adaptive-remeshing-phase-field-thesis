#!/bin/bash
#PBS -N PK_M1_2P_DC
#PBS -l nodes=1:ppn=1
#PBS -l pmem=16gb
#PBS -l walltime=00:30:00
#PBS -q normal_imfdfkmq
#PBS -o PK_M1_2P_DC.out
#PBS -e PK_M1_2P_DC.err

cd $PBS_O_WORKDIR

# STORAGE COMPLIANCE GUARD: Reject execution under /home
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
    echo "[STORAGE COMPLIANCE ERROR] Direct execution in /home filesystem is rejected by storage policy." >&2
    echo "Please execute solver jobs strictly from /scratch/pr21vyci/projects/adaptive-remeshing/ or /scratch9/." >&2
    exit 88
fi


module purge
module load abaqus/2023 intel/2024.2.0

echo "=== PBS Datacheck Started: $(date) ==="
echo "Host: $(hostname)"
echo "Directory: $(pwd)"

abaqus job=PK_MODE1_PROPOSED_PFM_VIS user=f42_mixed_uel.for input=PK_MODE1_PROPOSED_PFM_VIS.inp datacheck interactive

EXIT_CODE=$?
echo "Datacheck Exit Code: $EXIT_CODE"
echo "=== PBS Datacheck Finished: $(date) ==="
exit $EXIT_CODE
