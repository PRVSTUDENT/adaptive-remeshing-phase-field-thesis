#!/bin/bash
#PBS -N M2STAGE_F_VAL
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=24:00:00
#PBS -q entry_imfdfkmq
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de
#PBS -o pbs.out
#PBS -e pbs.err

cd $PBS_O_WORKDIR

# STORAGE COMPLIANCE GUARD: Reject execution under /home
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
    echo "[STORAGE COMPLIANCE ERROR] Direct execution in /home filesystem is rejected by storage policy." >&2
    echo "Please execute solver jobs strictly from /scratch/pr21vyci/projects/adaptive-remeshing/ or /scratch9/." >&2
    exit 88
fi


# Clean old lock files
rm -f *.lck

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

# Source dual-channel notifications
if [ -f "/home/pr21vyci/Adaptive_remeshing_clean/scripts/hpc/pbs_notify.sh" ]; then
    source "/home/pr21vyci/Adaptive_remeshing_clean/scripts/hpc/pbs_notify.sh"
    pbs_notify_install_traps
    pbs_notify_begin
fi

abaqus job=M2CORR_STAGE_F_TOPOLOGY_CHANGE_TRANSFER_VAL input=M2CORR_STAGE_F_TOPOLOGY_CHANGE_TRANSFER_VAL.inp user=f44_mixed_uel_restart_stateinit.for cpus=1 interactive
ABAQUS_RC=$?

if [ -f "/home/pr21vyci/Adaptive_remeshing_clean/scripts/hpc/pbs_notify.sh" ]; then
    pbs_notify_finish ${ABAQUS_RC}
fi

exit ${ABAQUS_RC}
