def _stage_state_startup(*args, **kwargs):
    import os, shutil
    cwd = os.getcwd()
    print('[ENV_HOOK] onJobStartup running in cwd: %s' % cwd)
    pkg_dir = os.environ.get('PBS_O_WORKDIR', os.environ.get('PWD', ''))
    if not pkg_dir or not os.path.exists(pkg_dir):
        pkg_dir = os.path.abspath(os.path.join(cwd, '..'))
    print('[ENV_HOOK] pkg_dir: %s' % pkg_dir)
    for fname in ['STAGE_D_COMMITTED_STATE.bin', 'MODE_STAGED.flag']:
        src = os.path.join(pkg_dir, fname)
        if not os.path.exists(src):
            src = os.path.join('/home/pr21vyci/projects/adaptive-remeshing/models/generated/mode_ii/stage_f_topology_batch/M2CORR_STAGE_F_TOPOLOGY_CHANGE_TRANSFER_VAL', fname)
        dst = os.path.join(cwd, fname)
        if os.path.exists(src) and not os.path.exists(dst):
            try:
                os.symlink(src, dst)
                print('[ENV_HOOK] Symlinked %s -> %s' % (src, dst))
            except Exception as e:
                shutil.copyfile(src, dst)
                print('[ENV_HOOK] Copied %s -> %s' % (src, dst))

onJobStartup = _stage_state_startup
del _stage_state_startup
