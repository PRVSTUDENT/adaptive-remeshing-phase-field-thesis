#!/bin/bash
#PBS -N M2RMREG6
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
set -uo pipefail
set +x
PACKAGE_DIR="${F19_PACKAGE_DIR:?F19_PACKAGE_DIR required}"
EVIDENCE_DIR="${F19_EVIDENCE_DIR:?F19_EVIDENCE_DIR required}"
WORK_ROOT="${SCRATCH:?SCRATCH required}/M2RMREG6_${PBS_JOBID:-unknown}"
F19_WORK_EVIDENCE_DIR="$WORK_ROOT/generated_evidence"
F19_FINAL_EVIDENCE_DIR="$EVIDENCE_DIR"
test ! -e "$WORK_ROOT" || exit 6
mkdir -p "$WORK_ROOT" "$F19_WORK_EVIDENCE_DIR" "$F19_FINAL_EVIDENCE_DIR" || exit 6
test -d "$F19_WORK_EVIDENCE_DIR" && test -w "$F19_WORK_EVIDENCE_DIR" && test -d "$F19_FINAL_EVIDENCE_DIR" && test -w "$F19_FINAL_EVIDENCE_DIR" || exit 6
cp -p "$PACKAGE_DIR"/runtime/* "$WORK_ROOT/" || exit 6
cd "$WORK_ROOT" || exit 6
export F19_OUTPUT_DIR="$F19_WORK_EVIDENCE_DIR"
export F19_SOURCE_ODB=/scratch/pr21vyci/adaptive-remeshing/runs/stage_f4/F4R1_20260730_065138_86ec6c79/miseseri_corrected/M2MISER1.odb
test "${F19_SOURCE_ODB#/}" != "$F19_SOURCE_ODB" && test -r "$F19_SOURCE_ODB" || exit 6
actual=$(sha256sum "$F19_SOURCE_ODB" | awk '{print $1}')
test "$actual" = bfcdbec08669774a9f80939d67c9c86ffe7df707e760450b08b1f6073fc588ac || exit 7
printf '{"path":"%s","readable":true,"sha256":"%s","work_output_writable":true,"final_output_writable":true}\n' "$F19_SOURCE_ODB" "$actual" > "$F19_WORK_EVIDENCE_DIR/ENVIRONMENT_CONTRACT_AUDIT.json"
export NOTIFICATION_EVIDENCE_DIR="$F19_FINAL_EVIDENCE_DIR" NOTIFICATION_CONFIG="$HOME/.config/adaptive-remeshing/notifications.env" NOTIFICATION_EMAIL_MODE=native_pbs NOTIFICATION_STAGE=F19 NOTIFICATION_RUN_ID="${PBS_JOBID:-unknown}" PBS_JOBNAME="${PBS_JOBNAME:-M2RMREG6}"
. ./job_notifications.sh
notification_load_config || exit 4
notification_install_terminal_trap
notify_start || exit 5
module purge && module load abaqus/2023 || exit 9
abaqus python f19_abaqus_python_compatibility.py > "$F19_WORK_EVIDENCE_DIR/compatibility.stdout" 2> "$F19_WORK_EVIDENCE_DIR/compatibility.stderr"
compatibility_rc=$?
printf '%s\n' "$compatibility_rc" > "$F19_WORK_EVIDENCE_DIR/compatibility.returncode"
python3 collect_f19_adaptive_evidence.py --work-dir "$F19_WORK_EVIDENCE_DIR" --final-dir "$F19_FINAL_EVIDENCE_DIR" --compatibility-rc "$compatibility_rc" --cae-rc -1 >/dev/null 2>&1 || true
test $compatibility_rc -eq 0 || exit $compatibility_rc
abaqus cae noGUI=qualify_f19_adaptive_region.py > "$F19_WORK_EVIDENCE_DIR/cae.stdout" 2> "$F19_WORK_EVIDENCE_DIR/cae.stderr"
cae_rc=$?
printf '%s\n' "$cae_rc" > "$F19_WORK_EVIDENCE_DIR/cae.returncode"
python3 collect_f19_adaptive_evidence.py --work-dir "$F19_WORK_EVIDENCE_DIR" --final-dir "$F19_FINAL_EVIDENCE_DIR" --compatibility-rc "$compatibility_rc" --cae-rc "$cae_rc"
collector_rc=$?
test $cae_rc -eq 0 || exit $cae_rc
test $collector_rc -eq 0 || exit 11
(cd "$F19_FINAL_EVIDENCE_DIR" && sha256sum -c EVIDENCE_MANIFEST.sha256) || exit 12
exit 0
