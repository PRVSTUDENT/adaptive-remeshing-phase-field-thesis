#!/bin/bash
#PBS -N M2RMEXEC1
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
set -uo pipefail
PACKAGE_DIR="${F21_PACKAGE_DIR:?F21_PACKAGE_DIR required}"; EVIDENCE_DIR="${F21_EVIDENCE_DIR:?F21_EVIDENCE_DIR required}"
WORK_ROOT="${SCRATCH:?SCRATCH required}/M2RMEXEC1_${PBS_JOBID:-unknown}"; WORK_EVIDENCE="$WORK_ROOT/evidence"
test ! -e "$WORK_ROOT" || exit 6; mkdir -p "$WORK_ROOT" "$WORK_EVIDENCE" "$EVIDENCE_DIR" || exit 6
cp -p "$PACKAGE_DIR"/runtime/* "$WORK_ROOT/" || exit 6; cd "$WORK_ROOT" || exit 6
export F21_OUTPUT_DIR="$WORK_EVIDENCE" F21_SOURCE_ODB=/scratch/pr21vyci/adaptive-remeshing/runs/stage_f4/F4R1_20260730_065138_86ec6c79/miseseri_corrected/M2MISER1.odb
cp -p "$PACKAGE_DIR/runtime/source_deck.inp" ./source_deck.inp || exit 6
test "$(sha256sum "$F21_SOURCE_ODB"|awk '{print $1}')" = bfcdbec08669774a9f80939d67c9c86ffe7df707e760450b08b1f6073fc588ac || exit 7
printf '{"source_odb_read_only":true,"source_odb_hash_match":true,"work_root":"%s"}\n' "$WORK_ROOT" > "$WORK_EVIDENCE/ENVIRONMENT_CONTRACT_AUDIT.json"
export NOTIFICATION_EVIDENCE_DIR="$EVIDENCE_DIR" NOTIFICATION_CONFIG="$HOME/.config/adaptive-remeshing/notifications.env" NOTIFICATION_EMAIL_MODE=native_pbs NOTIFICATION_STAGE=F21 NOTIFICATION_RUN_ID="${PBS_JOBID:-unknown}" PBS_JOBNAME="${PBS_JOBNAME:-M2RMEXEC1}"
. ./job_notifications.sh; notification_load_config || exit 4; notification_install_terminal_trap; notify_start || exit 5
module purge && module load abaqus/2023 || exit 9
abaqus python f21_abaqus_python_compatibility.py > "$WORK_EVIDENCE/compatibility.stdout" 2> "$WORK_EVIDENCE/compatibility.stderr"; compatibility_rc=$?; printf '%s\n' "$compatibility_rc" > "$WORK_EVIDENCE/compatibility.returncode"
test $compatibility_rc -eq 0 || { python3 collect_f21_evidence.py --work-dir "$WORK_EVIDENCE" --final-dir "$EVIDENCE_DIR" --cae-rc -1 || true; exit $compatibility_rc; }
abaqus cae noGUI=execute_f21_native_remesh.py > "$WORK_EVIDENCE/cae.stdout" 2> "$WORK_EVIDENCE/cae.stderr"; cae_rc=$?; printf '%s\n' "$cae_rc" > "$WORK_EVIDENCE/cae.returncode"
python3 collect_f21_evidence.py --work-dir "$WORK_EVIDENCE" --final-dir "$EVIDENCE_DIR" --cae-rc "$cae_rc"; collector_rc=$?
test $cae_rc -eq 0 || exit $cae_rc; test $collector_rc -eq 0 || exit 11
(cd "$EVIDENCE_DIR" && sha256sum -c EVIDENCE_MANIFEST.sha256) || exit 12
exit 0
