#!/bin/bash
#PBS -N F42TRI2
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -V
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de,Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de

set -euo pipefail

# Guarded submission wrapper enforcement
if [ "${F42TRI2_WRAPPER_AUTHORIZED:-0}" -ne 1 ]; then
    echo "ERROR: Direct qsub execution prohibited. Must submit via submit_f42tri2.sh" >&2
    exit 1
fi

cd "${PBS_O_WORKDIR}"
EVIDENCE_DIR="${PBS_O_WORKDIR}/evidence/${PBS_JOBID}"
mkdir -p "${EVIDENCE_DIR}"

echo "=== F42TRI2 Execution Start: $(date) ===" | tee "${EVIDENCE_DIR}/execution.log"
echo "Job ID: ${PBS_JOBID}" | tee -a "${EVIDENCE_DIR}/execution.log"
echo "Host: $(hostname)" | tee -a "${EVIDENCE_DIR}/execution.log"

module load intel/2024.2.0 abaqus/2023 || true

abaqus job=F42TRI2 user=f42c_mixed_uel.for input=F42TRI2.inp cpus=1 interactive 2>&1 | tee -a "${EVIDENCE_DIR}/execution.log" || true

bash collect_f42tri2_evidence.sh "${PBS_JOBID}" "${EVIDENCE_DIR}"
python3 validate_f42tri2_runtime.py "${EVIDENCE_DIR}"
