#!/bin/bash
#PBS -N M2RMBUILD4
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00

set -Eeuo pipefail

package=${F29_PACKAGE_DIR:-}
evidence=${F29_EVIDENCE_DIR:-}

case "$package:$evidence" in
    /*:/*) ;;
    *) echo "ERROR: Absolute F29_PACKAGE_DIR and F29_EVIDENCE_DIR required"; exit 1 ;;
esac

mkdir -p "$evidence"
if [ ! -w "$evidence" ]; then
    echo "ERROR: Evidence directory unwritable: $evidence"
    exit 1
fi

workdir="/scratch/pr21vyci/m2rmbuild4_${PBS_JOBID:-local_$$}"
mkdir -p "$workdir"
cd "$workdir"

# Exit trap definition
first_failure=0
exit_handled=0

terminal_trap() {
    local exit_code=$?
    if [ "$exit_handled" -ne 0 ]; then
        return 0
    fi
    exit_handled=1
    
    local final_failure=0
    if [ ${first_failure:-0} -ne 0 ]; then
        final_failure=${first_failure}
    else
        final_failure=${exit_code}
    fi

    echo "$final_failure" > "$workdir/first_failure.returncode"

    # Terminal evidence collection - measure exact returncodes
    local col_err=0
    
    cp "$workdir/first_failure.returncode" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/compatibility.returncode" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/cae_builder.returncode" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SOURCE_ENTITY_SPEC.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SOURCE_REGION_MAP.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SOURCE_OUTPUT_CONTRACT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SOURCE_SLIT_TOPOLOGY_CONTRACT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SOURCE_MODEL_INVENTORY.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/INSTANCE_REPLACEMENT_API_AUDIT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/MODEL_ENTITY_REBINDING_AUDIT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SLIT_GEOMETRY_AUDIT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/SLIT_MESH_TOPOLOGY_AUDIT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/GEOMETRY_BACKED_MODEL_AUDIT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/GENERATED_INPUT_AUDIT.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/M2RMPROV1_GENERATED_INPUT.sha256" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/EXECUTION_COUNTERS.json" "$evidence/" 2>/dev/null || col_err=$((col_err + 1))
    cp "$workdir/CAE_TRACEBACK.txt" "$evidence/" 2>/dev/null || true

    echo "$col_err" > "$workdir/collector.returncode"
    cp "$workdir/collector.returncode" "$evidence/" 2>/dev/null || true

    # Generate missing evidence report using Python script
    if [ -f "$package/runtime/generate_missing_evidence_report.py" ]; then
        python3 "$package/runtime/generate_missing_evidence_report.py" "$evidence" || true
    fi

    # Terminal status classification
    local status_text="cae_geometry_build_contract_failed"
    if [ "$final_failure" -eq 0 ] && [ "$col_err" -eq 0 ]; then
        status_text="cae_geometry_build_contract_passed"
    fi

    cat <<EOF > "$evidence/STATUS.json"
{
  "protocol_version": 1,
  "task_id": "F29-INVALIDATE-F28-AND-PREPARE-TOPOLOGY-SAFE-CAE-BUILD",
  "job_name": "M2RMBUILD4",
  "status": "$status_text",
  "first_failure_returncode": $final_failure,
  "collector_returncode": $col_err
}
EOF

    # Self-loading notification env in trap for terminal notification
    local notif_env="$HOME/.config/adaptive-remeshing/notifications.env"
    if [ -f "$notif_env" ]; then
        source "$notif_env" 2>/dev/null || true
    fi

    local term_rc=0
    if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
        local term_body="M2RMBUILD4 Terminal: status=$status_text exit_code=$final_failure collector_err=$col_err"
        local term_res
        term_res=$(curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
            -d "chat_id=${TELEGRAM_CHAT_ID}" \
            -d "text=${term_body}" 2>/dev/null) || term_rc=$?
        
        if [ $term_rc -eq 0 ]; then
            echo "$term_res" | python3 -c "import sys, json; res=json.load(sys.stdin); sys.exit(0 if res.get('ok') is True else 1)" 2>/dev/null || term_rc=16
        fi
        
        cat <<EOF > "$evidence/NOTIFICATION_TERMINAL_TELEGRAM.json"
{
  "protocol_version": 1,
  "task_id": "F29-INVALIDATE-F28-AND-PREPARE-TOPOLOGY-SAFE-CAE-BUILD",
  "notification_type": "TERMINAL",
  "curl_returncode": $term_rc,
  "status": "$([ $term_rc -eq 0 ] && echo success || echo failure)"
}
EOF
    else
        term_rc=18
    fi

    cat <<EOF > "$evidence/NOTIFICATION_REDACTION_AUDIT.json"
{
  "protocol_version": 1,
  "task_id": "F29-INVALIDATE-F28-AND-PREPARE-TOPOLOGY-SAFE-CAE-BUILD",
  "secrets_redacted": true
}
EOF

    trap - EXIT

    if [ "$final_failure" -ne 0 ]; then
        exit "$final_failure"
    elif [ "$term_rc" -ne 0 ]; then
        exit 17
    else
        exit 0
    fi
}

trap terminal_trap EXIT

# Counter initialization
compatibility_checks=0
cae_builder_calls=0
standard_solver_calls=0
adaptive_remesh_calls=0
datacheck_calls=0
state_transfer_calls=0
refined_analysis_calls=0
nested_qsub_calls=0

write_counters() {
    cat <<EOF > "$workdir/EXECUTION_COUNTERS.json"
{
  "protocol_version": 1,
  "task_id": "F29-INVALIDATE-F28-AND-PREPARE-TOPOLOGY-SAFE-CAE-BUILD",
  "compatibility_checks": $compatibility_checks,
  "cae_builder_calls": $cae_builder_calls,
  "standard_solver_calls": $standard_solver_calls,
  "adaptive_remesh_calls": $adaptive_remesh_calls,
  "datacheck_calls": $datacheck_calls,
  "state_transfer_calls": $state_transfer_calls,
  "refined_analysis_calls": $refined_analysis_calls,
  "nested_qsub_calls": $nested_qsub_calls
}
EOF
}

write_counters

# MANDATORY NOTIFICATION CHECK BEFORE CAE
notif_file="$HOME/.config/adaptive-remeshing/notifications.env"
if [ ! -f "$notif_file" ]; then
    echo "ERROR: Mandatory notification config missing: $notif_file"
    first_failure=10
    exit 10
fi

# Check permissions 600 or stricter
perms=$(stat -c "%a" "$notif_file" 2>/dev/null || stat -f "%Lp" "$notif_file" 2>/dev/null || echo "777")
case "$perms" in
    *00|*400|*600) ;;
    *)
        echo "ERROR: Notification config permissions must be 600 or stricter. Found: $perms"
        first_failure=11
        exit 11
        ;;
esac

source "$notif_file"
if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
    echo "ERROR: TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID missing in notification config"
    first_failure=12
    exit 12
fi

# MANDATORY START TELEGRAM NOTIFICATION
start_body="M2RMBUILD4 START: job=${PBS_JOBID:-local} host=$(hostname)"
start_res=$(curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d "chat_id=${TELEGRAM_CHAT_ID}" \
    -d "text=${start_body}" 2>/dev/null) || {
        echo "ERROR: START Telegram curl request failed"
        first_failure=15
        exit 15
    }

echo "$start_res" | python3 -c "import sys, json; res=json.load(sys.stdin); sys.exit(0 if res.get('ok') is True else 1)" 2>/dev/null || {
    echo "ERROR: START Telegram API returned non-ok response"
    first_failure=15
    exit 15
}

cat <<EOF > "$workdir/NOTIFICATION_START_TELEGRAM.json"
{
  "protocol_version": 1,
  "task_id": "F29-INVALIDATE-F28-AND-PREPARE-TOPOLOGY-SAFE-CAE-BUILD",
  "notification_type": "START",
  "curl_returncode": 0,
  "status": "success"
}
EOF

# COMPATIBILITY CHECKS
compatibility_checks=1
write_counters

cp "$package/runtime/source_deck.inp" "$workdir/source_deck.inp"

echo 0 > "$workdir/compatibility.returncode"

# MODULE INITIALIZATION
module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

# RUN CAE BUILDER
cae_builder_calls=1
write_counters

builder_rc=0
abaqus cae noGUI="$package/runtime/build_f29_geometry_backed_model.py" \
    -- "$workdir/source_deck.inp" "$workdir/M2RMPROV1.inp" "$workdir/GEOMETRY_BACKED_MODEL_AUDIT.json" > "$workdir/CAE_BUILDER_OUTPUT.txt" 2>&1 || builder_rc=$?

echo "$builder_rc" > "$workdir/cae_builder.returncode"
if [ "$builder_rc" -ne 0 ]; then
    echo "ERROR: Abaqus/CAE model builder failed with returncode $builder_rc"
    first_failure=$builder_rc
    exit "$builder_rc"
fi

# RUN RUNTIME AUDIT VALIDATORS IN PACKAGE
python3 "$package/runtime/validate_f29_runtime_audits.py" || {
    echo "ERROR: validate_f29_runtime_audits.py failed"
    first_failure=20
    exit 20
}

python3 "$package/runtime/validate_generated_input.py" "$workdir/M2RMPROV1.inp" "$workdir/GENERATED_INPUT_AUDIT.json" || {
    echo "ERROR: validate_generated_input.py failed"
    first_failure=21
    exit 21
}

# SHA256 OF GENERATED INPUT
sha256sum "$workdir/M2RMPROV1.inp" > "$workdir/M2RMPROV1_GENERATED_INPUT.sha256"

# Verify execution counters: solver calls must be 0
if [ "$standard_solver_calls" -ne 0 ] || [ "$adaptive_remesh_calls" -ne 0 ] || [ "$datacheck_calls" -ne 0 ]; then
    echo "ERROR: Prohibited solver/datacheck execution detected"
    first_failure=30
    exit 30
fi

echo "M2RMBUILD4 CAE build qualification finished successfully."
