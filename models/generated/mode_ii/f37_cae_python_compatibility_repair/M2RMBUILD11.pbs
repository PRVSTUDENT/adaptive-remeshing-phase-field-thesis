#!/bin/bash
#PBS -N M2RMBUILD11
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -Eeuo pipefail

# Mandatory Environment Variables
if [ -z "${F37_PACKAGE_DIR:-}" ] || [ -z "${F37_EVIDENCE_DIR:-}" ]; then
  echo "ERROR: F37_PACKAGE_DIR and F37_EVIDENCE_DIR must be set."
  exit 12
fi

mkdir -p "$F37_EVIDENCE_DIR"

# Execution Counters (Initialize to 0)
compatibility_checks=0
python_probe_calls=0
cae_builder_calls=0
standard_solver_calls=0
adaptive_remesh_calls=0
datacheck_calls=0
state_transfer_calls=0
refined_analysis_calls=0
nested_qsub_calls=0

cae_builder_rc="skipped"
gen_input_rc="skipped"
runtime_val_rc="skipped"
compat_rc="skipped"
python_probe_rc="skipped"
collector_rc=0
term_notify_rc=0
start_sent=false

# Exit Trap - Attempt Terminal Notification on ALL Termination Paths
on_exit() {
  first_failure=$?
  trap - EXIT

  echo "INFO: Running terminal evidence collection and closeout trap..."

  # 1. Write actual execution counters
  cat << EOF > "EXECUTION_COUNTERS.json"
{
  "compatibility_checks": $compatibility_checks,
  "python_probe_calls": $python_probe_calls,
  "cae_builder_calls": $cae_builder_calls,
  "standard_solver_calls": $standard_solver_calls,
  "adaptive_remesh_calls": $adaptive_remesh_calls,
  "datacheck_calls": $datacheck_calls,
  "state_transfer_calls": $state_transfer_calls,
  "refined_analysis_calls": $refined_analysis_calls,
  "nested_qsub_calls": $nested_qsub_calls
}
EOF

  # 2. Write returncode files
  echo "$compat_rc" > compatibility.returncode
  echo "$python_probe_rc" > python_probe.returncode
  echo "$cae_builder_rc" > cae_builder.returncode
  echo "$gen_input_rc" > generated_input_validator.returncode
  echo "$runtime_val_rc" > runtime_validator.returncode
  echo "$first_failure" > first_failure.returncode

  # 3. Terminal Telegram Notification (Attempted on ALL paths)
  NOTIF_CONFIG="$HOME/.config/adaptive-remeshing/notifications.env"
  if [ -f "$NOTIF_CONFIG" ]; then
    source "$NOTIF_CONFIG" || true
  fi

  if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
    echo "INFO: Sending terminal Telegram notification..."
    msg_text="M2RMBUILD11 Terminal Status: exit=$first_failure, compat_rc=$compat_rc, cae_rc=$cae_builder_rc, gen_rc=$gen_input_rc, val_rc=$runtime_val_rc"

    set +e
    term_resp=$(curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
      -d "chat_id=${TELEGRAM_CHAT_ID}" \
      -d "text=${msg_text}")
    term_curl_rc=$?
    set -e

    cat << EOF > TERMINAL_NOTIFICATION_RESULT.json
{
  "telegram_api_response": $term_resp,
  "curl_exit_code": $term_curl_rc
}
EOF
    if [ "$term_curl_rc" -ne 0 ] || ! echo "$term_resp" | grep -q '"ok":true'; then
      term_notify_rc=17
    fi
  fi

  # 4. Write Redaction Audit
  cat << EOF > REDACTION_AUDIT.json
{
  "secrets_redacted": true,
  "telegram_token_logged": false
}
EOF

  # 5. Unmasked Evidence Collection to $F37_EVIDENCE_DIR
  collect_fail_count=0
  for f in EMBEDDED_PYTHON_COMPATIBILITY_AUDIT.json RUNTIME_FAILURE_AUDIT.json SOURCE_MODEL_INVENTORY.json INSTANCE_REPLACEMENT_API_AUDIT.json MODEL_ENTITY_REBINDING_AUDIT.json \
           SLIT_GEOMETRY_AUDIT.json SLIT_MESH_TOPOLOGY_AUDIT.json GEOMETRY_BACKED_MODEL_AUDIT.json \
           GENERATED_INPUT_AUDIT.json COMPATIBILITY_AUDIT.json EXECUTION_COUNTERS.json \
           START_NOTIFICATION_RESULT.json TERMINAL_NOTIFICATION_RESULT.json REDACTION_AUDIT.json \
           compatibility.returncode python_probe.returncode cae_builder.returncode generated_input_validator.returncode \
           runtime_validator.returncode first_failure.returncode M2RMPROV4.inp abaqus.rpy; do
    if [ -f "$f" ]; then
      cp "$f" "$F37_EVIDENCE_DIR/" || collect_fail_count=$((collect_fail_count + 1))
    fi
  done

  echo "$collect_fail_count" > collector.returncode
  cp collector.returncode "$F37_EVIDENCE_DIR/" || true

  # 6. Final Runtime STATUS.json (Strict Runtime Classifications Only)
  if [ "$first_failure" -eq 0 ] && [ "$collect_fail_count" -eq 0 ] && [ "$term_notify_rc" -eq 0 ]; then
    runtime_class="cae_geometry_build_contract_passed"
  else
    runtime_class="cae_geometry_build_contract_failed"
  fi

  cat << EOF > STATUS.json
{
  "protocol_version": 1,
  "task_id": "F37-M2RMBUILD11-OFFLINE-REPAIR",
  "classification": "$runtime_class",
  "first_failure_exit_code": $first_failure,
  "collector_fail_count": $collect_fail_count,
  "terminal_notification_rc": $term_notify_rc
}
EOF
  cp STATUS.json "$F37_EVIDENCE_DIR/" || true

  # 7. Generate missing-evidence report only after STATUS is present.
  if [ -f "$F37_PACKAGE_DIR/runtime/generate_missing_evidence_report.py" ]; then
    python3 "$F37_PACKAGE_DIR/runtime/generate_missing_evidence_report.py" "$F37_EVIDENCE_DIR" || true
  fi

  # Determine exit status
  if [ "$first_failure" -ne 0 ]; then
    exit "$first_failure"
  elif [ "$collect_fail_count" -ne 0 ]; then
    exit 18
  elif [ "$term_notify_rc" -ne 0 ]; then
    exit 17
  else
    exit 0
  fi
}

trap on_exit EXIT

# Isolated Scratch Workspace
WORK_DIR="/scratch/pr21vyci/m2rmbuild11_${PBS_JOBID:-local}"
mkdir -p "$WORK_DIR"
mkdir -p "$WORK_DIR/runtime"
cd "$WORK_DIR"

# Stage Complete Package Files to $WORK_DIR
cp "$F37_PACKAGE_DIR/PACKAGE_MANIFEST.json" .
cp "$F37_PACKAGE_DIR/SHA256SUMS" .
cp "$F37_PACKAGE_DIR/F37_SHA256SUMS" .
cp "$F37_PACKAGE_DIR/M2RMBUILD11.pbs" .
cp "$F37_PACKAGE_DIR/runtime/"* runtime/

# Real Compatibility Gate Execution
compatibility_checks=1
echo "INFO: Performing real compatibility checks..."

sha256sum -c SHA256SUMS
sha256sum -c F37_SHA256SUMS

bash -n "$F37_PACKAGE_DIR/M2RMBUILD11.pbs"

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

resolved_abaqus=$(command -v abaqus || echo "absent")
resolved_python3=$(command -v python3 || echo "absent")

if [ "$resolved_abaqus" = "absent" ]; then
  echo "ERROR: abaqus executable not found after module load"
  exit 14
fi

if [ "$resolved_python3" = "absent" ]; then
  echo "ERROR: python3 executable not found after module load"
  exit 14
fi

abaqus_ver=$(abaqus information=environment 2>&1 | head -n 10 | tr '\n' ' ' || echo "version_unknown")
python_ver=$(python3 --version 2>&1 || echo "version_unknown")

cat << EOF > COMPATIBILITY_AUDIT.json
{
  "protocol_version": 1,
  "task_id": "F37-M2RMBUILD11-OFFLINE-REPAIR",
  "package_manifest_verified": true,
  "f37_manifest_verified": true,
  "source_deck_verified": true,
  "runtime_scripts_verified": true,
  "pbs_shell_syntax_verified": true,
  "modules_loaded": ["gcc/11.4.0", "intel/2024.2.0", "abaqus/2023"],
  "abaqus_executable": "$resolved_abaqus",
  "python_executable": "$resolved_python3",
  "abaqus_version_raw": "$abaqus_ver",
  "python_version_raw": "$python_ver",
  "compatibility_pass": true
}
EOF
compat_rc=0

export F37_PYTHON_COMPATIBILITY_AUDIT="$WORK_DIR/EMBEDDED_PYTHON_COMPATIBILITY_AUDIT.json"
python_probe_calls=1
set +e
abaqus python "$WORK_DIR/runtime/probe_f37_python_compatibility.py"
python_probe_rc=$?
set -e
if [ "$python_probe_rc" -ne 0 ]; then
  echo "ERROR: Abaqus embedded-Python compatibility probe failed with return code $python_probe_rc"
  exit "$python_probe_rc"
fi

# START Telegram Notification
NOTIF_CONFIG="$HOME/.config/adaptive-remeshing/notifications.env"
if [ -f "$NOTIF_CONFIG" ]; then
  source "$NOTIF_CONFIG" || true
fi

if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
  echo "INFO: Sending START Telegram notification..."
  start_msg="M2RMBUILD11 START: Job execution started on $(hostname) at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  set +e
  start_resp=$(curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d "chat_id=${TELEGRAM_CHAT_ID}" \
    -d "text=${start_msg}")
  start_curl_rc=$?
  set -e
  cat << EOF > START_NOTIFICATION_RESULT.json
{
  "telegram_api_response": $start_resp,
  "curl_exit_code": $start_curl_rc
}
EOF
  if [ "$start_curl_rc" -eq 0 ] && echo "$start_resp" | grep -q '"ok":true'; then
    start_sent=true
  else
    echo "ERROR: START Telegram notification failed."
    exit 15
  fi
fi

# Execute CAE Model Builder
cae_builder_calls=1
echo "INFO: Running Abaqus/CAE geometry model builder..."

export F37_SOURCE_DECK="$WORK_DIR/runtime/source_deck.inp"
export F37_OUTPUT_INPUT="$WORK_DIR/M2RMPROV4.inp"
export F37_GEOMETRY_AUDIT="$WORK_DIR/GEOMETRY_BACKED_MODEL_AUDIT.json"
export F37_RUNTIME_FAILURE_AUDIT="$WORK_DIR/RUNTIME_FAILURE_AUDIT.json"

set +e
abaqus cae noGUI="$WORK_DIR/runtime/build_f37_geometry_backed_model.py"
cae_builder_rc=$?
set -e

if [ "$cae_builder_rc" -ne 0 ]; then
  echo "ERROR: Abaqus/CAE model builder failed with returncode $cae_builder_rc"
  exit "$cae_builder_rc"
fi

# Validate Generated Input Deck
echo "INFO: Validating generated input deck..."
set +e
python3 "$WORK_DIR/runtime/validate_generated_input.py"
gen_input_rc=$?
set -e

if [ "$gen_input_rc" -ne 0 ]; then
  echo "ERROR: Generated input deck validator failed with returncode $gen_input_rc"
  exit "$gen_input_rc"
fi

# Validate Aggregate Runtime Audits
echo "INFO: Validating aggregate runtime audits..."
cat << EOF > EXECUTION_COUNTERS.json
{
  "compatibility_checks": $compatibility_checks,
  "python_probe_calls": $python_probe_calls,
  "cae_builder_calls": $cae_builder_calls,
  "standard_solver_calls": $standard_solver_calls,
  "adaptive_remesh_calls": $adaptive_remesh_calls,
  "datacheck_calls": $datacheck_calls,
  "state_transfer_calls": $state_transfer_calls,
  "refined_analysis_calls": $refined_analysis_calls,
  "nested_qsub_calls": $nested_qsub_calls
}
EOF
set +e
python3 "$WORK_DIR/runtime/validate_f37_runtime_audits.py"
runtime_val_rc=$?
set -e

if [ "$runtime_val_rc" -ne 0 ]; then
  echo "ERROR: Runtime audit validator failed with returncode $runtime_val_rc"
  exit "$runtime_val_rc"
fi

echo "SUCCESS: M2RMBUILD11 CAE build qualification completed cleanly."
