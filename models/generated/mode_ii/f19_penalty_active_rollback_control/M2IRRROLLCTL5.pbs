#!/bin/bash
#PBS -N M2IRRROLLCTL5
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -m abe
set -uo pipefail
set +x
PACKAGE_DIR="${F19_PACKAGE_DIR:?F19_PACKAGE_DIR required}"
EVIDENCE_DIR="${F19_EVIDENCE_DIR:?F19_EVIDENCE_DIR required}"
WORK_ROOT="${SCRATCH:?SCRATCH required}/M2IRRROLLCTL5_${PBS_JOBID:-unknown}"
test ! -e "$WORK_ROOT" || exit 6
mkdir -p "$WORK_ROOT" "$EVIDENCE_DIR" || exit 6
cp -p "$PACKAGE_DIR"/runtime/* "$WORK_ROOT/" || exit 6
cd "$WORK_ROOT" || exit 6
export NOTIFICATION_EVIDENCE_DIR="$EVIDENCE_DIR" NOTIFICATION_CONFIG="$HOME/.config/adaptive-remeshing/notifications.env" NOTIFICATION_EMAIL_MODE=native_pbs NOTIFICATION_STAGE=F19 NOTIFICATION_RUN_ID="${PBS_JOBID:-unknown}" PBS_JOBNAME="${PBS_JOBNAME:-M2IRRROLLCTL5}"
. ./job_notifications.sh
notification_load_config || exit 4
notification_install_terminal_trap
notify_start || exit 5
mode_file="${PBS_JOBNAME}_f19_force_mode.flag"
state_file="${PBS_JOBNAME}_f19_cutback_state.flag"
test ! -e "$mode_file" && test ! -e "$state_file" || exit 7
printf '0\n' > "$mode_file" && printf '0\n' > "$state_file" || exit 7
test -f "$mode_file" && test -r "$mode_file" && test "$(cat "$mode_file")" = 0 || exit 7
test -f "$state_file" && test -r "$state_file" && test "$(cat "$state_file")" = 0 || exit 7
module purge && module load gcc/11.4.0 intel/2024.2.0 abaqus/2023 || exit 8
printf '0\n' > f19_harness_force_mode.flag
printf '0\n' > f19_harness_cutback_state.flag
ifort -extend-source -o f19_flag_io_harness f19_flag_io_harness.for > harness_compile.stdout 2> harness_compile.stderr || exit 9
./f19_flag_io_harness > harness_run.stdout 2> harness_run.stderr || exit 9
grep -q 'F19_HARNESS_PASS' harness_run.stdout || exit 9
abaqus job=M2IRRROLLCTL5 input=M2IRR_F18.inp user=M2IRR_F18.for interactive
rc=$?
for ext in sta msg dat log; do test -s "M2IRRROLLCTL5.$ext" && cp -p "M2IRRROLLCTL5.$ext" "$EVIDENCE_DIR/"; done
for f in harness_compile.stdout harness_compile.stderr harness_run.stdout harness_run.stderr "$mode_file" "$state_file"; do test -e "$f" && cp -p "$f" "$EVIDENCE_DIR/"; done
test $rc -eq 0 || exit $rc
abaqus python extract_stage_f18_rollback.py --odb M2IRRROLLCTL5.odb --output-dir extracted --role candidate || exit 10
python3 analyze_stage_f18_rollback.py --log M2IRRROLLCTL5_f18_rollback_calls.log --extracted extracted --output STATUS.json || exit 11
for f in response_curve.csv phase_history.csv energy_history.csv accepted_increments.csv cutback_attempts.csv; do test -s "extracted/$f" || exit 12; cp -p "extracted/$f" "$EVIDENCE_DIR/"; done
cp -p STATUS.json M2IRRROLLCTL5_f18_rollback_calls.log "$EVIDENCE_DIR/" || exit 13
(cd "$EVIDENCE_DIR" && sha256sum STATUS.json M2IRRROLLCTL5_f18_rollback_calls.log response_curve.csv phase_history.csv energy_history.csv accepted_increments.csv cutback_attempts.csv > EXTRACTION_MANIFEST.sha256 && sha256sum -c EXTRACTION_MANIFEST.sha256) || exit 14
exit 0
