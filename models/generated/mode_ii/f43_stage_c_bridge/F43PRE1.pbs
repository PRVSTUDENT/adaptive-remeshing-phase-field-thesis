#!/bin/bash
#PBS -N F43PRE1
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -V
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de,Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de

set -euo pipefail

# Guarded submission wrapper enforcement
if [ "${F43PRE1_WRAPPER_AUTHORIZED:-0}" -ne 1 ]; then
    echo "ERROR: Direct qsub execution prohibited. Must submit via submit_f43pre1.sh" >&2
    exit 1
fi

cd "${PBS_O_WORKDIR}"
EVIDENCE_DIR="${PBS_O_WORKDIR}/evidence/${PBS_JOBID}"
mkdir -p "${EVIDENCE_DIR}"

echo "=== F43PRE1 Execution Start: $(date) ===" | tee "${EVIDENCE_DIR}/execution.log"
echo "Job ID: ${PBS_JOBID}" | tee -a "${EVIDENCE_DIR}/execution.log"
echo "Host: $(hostname)" | tee -a "${EVIDENCE_DIR}/execution.log"

module load abaqus/2023

echo "=== Module Environment State ===" | tee -a "${EVIDENCE_DIR}/execution.log"
module list 2>&1 | tee -a "${EVIDENCE_DIR}/execution.log"

echo "=== Toolchain Preflight Checks ===" | tee -a "${EVIDENCE_DIR}/execution.log"
ABAQUS_PATH="$(command -v abaqus)"
echo "abaqus resolved path: ${ABAQUS_PATH}" | tee -a "${EVIDENCE_DIR}/execution.log"
abaqus information=release 2>&1 | head -n 5 | tee -a "${EVIDENCE_DIR}/execution.log" || true

abaqus job=F43PRE1 input=F43PRE1.inp cpus=1 interactive 2>&1 | tee -a "${EVIDENCE_DIR}/execution.log" || true

bash collect_f43pre1_evidence.sh "${PBS_JOBID}" "${EVIDENCE_DIR}"
python3 validate_f43pre1_runtime.py "${EVIDENCE_DIR}"
