#!/bin/bash
#PBS -N M2REF_H2_FRACFIX
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=04:00:00
#PBS -q entry_imfdfkmq
#PBS -m abe
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -j oe
#PBS -o evidence/$PBS_JOBID/execution.log

set -euo pipefail

# Storage-compliance guard: reject execution directly under /home
CURRENT_DIR="$(pwd -P)"
if [[ "$CURRENT_DIR" =~ ^/home/ ]]; then
  echo "[STORAGE COMPLIANCE ERROR] Execution directly inside /home is prohibited." >&2
  echo "Heavy simulation outputs (*.odb, *.sim, *.res) must be written to /scratch/." >&2
  echo "Please execute from /scratch/pr21vyci/projects/adaptive-remeshing/..." >&2
  exit 88
fi

cd "$PBS_O_WORKDIR"
mkdir -p evidence/"$PBS_JOBID"

echo "=== Host Environment ==="
hostname
date
module list || true

module load gcc/11.4.0 intel/2024.2.0 abaqus/2023 python/gcc/11.4.0/3.11.7

echo "=== Running Abaqus Job M2REF_H2_FRACFIX ==="
abaqus job=M2REF_H2_FRACFIX input=M2REF_H2_FRACFIX.inp user=f42_mixed_uel.for cpus=1 interactive double=both ask_delete=OFF

echo "=== Execution Complete ==="
date
