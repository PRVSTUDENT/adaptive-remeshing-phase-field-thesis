#!/bin/bash
#PBS -N M2RMBISECT1
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -Eeuo pipefail

# Check direct execution rejection guard
if [ "${F40_GUARDED_WRAPPER_INVOKED:-0}" -ne 1 ]; then
    echo "FATAL: Direct execution of M2RMBISECT1.pbs is prohibited. Must be submitted via submit_stage_f40_cae_bisect.sh wrapper." >&2
    exit 1
fi

# Check PBS batch provenance guard
if [ "${PBS_ENVIRONMENT:-}" != "PBS_BATCH" ] || [ -z "${PBS_O_HOST:-}" ] || [ -z "${PBS_QUEUE:-}" ] || [ -z "${PBS_JOBID:-}" ] || [ -z "${PBS_NODEFILE:-}" ] || [ ! -f "${PBS_NODEFILE}" ] || [ ! -s "${PBS_NODEFILE}" ]; then
    echo "FATAL: Genuine PBS batch provenance required (missing or invalid PBS_JOBID, PBS_ENVIRONMENT, PBS_O_HOST, PBS_QUEUE, or PBS_NODEFILE)." >&2
    exit 1
fi

CURRENT_SHORT_HOST=$(hostname -s 2>/dev/null || hostname)
CURRENT_FULL_HOST=$(hostname -f 2>/dev/null || hostname)

if ! grep -Fxq "$CURRENT_SHORT_HOST" "$PBS_NODEFILE" && ! grep -Fxq "$CURRENT_FULL_HOST" "$PBS_NODEFILE"; then
    echo "FATAL: Current compute host is absent from PBS_NODEFILE." >&2
    exit 1
fi

F40_PACKAGE_DIR="${F40_PACKAGE_DIR:?F40_PACKAGE_DIR must be exported by launcher}"
F40_EVIDENCE_ROOT="${F40_EVIDENCE_ROOT:-${PBS_O_WORKDIR:-$(pwd)}/runs/hpc/stage_f/f40_f38_cae_invocation_model_building_bisect/evidence}"
F40_EVIDENCE_DIR="${F40_EVIDENCE_ROOT}/${PBS_JOBID}"

WORK_DIR="${PBS_O_WORKDIR:-$(pwd)}/runs/hpc/stage_f/f40_f38_cae_invocation_model_building_bisect/M2RMBISECT1_${PBS_JOBID}"
mkdir -p "$WORK_DIR" "$F40_EVIDENCE_DIR"
cd "$WORK_DIR"

mkdir -p "$WORK_DIR/runtime"
find "$F40_PACKAGE_DIR/runtime/" -maxdepth 1 -type f -exec cp {} "$WORK_DIR/runtime/" \;

delta_auditor_rc=1
bisection_runner_rc=1
f38_entrypoint_rc=1
f38_matrix_validator_rc=1
runtime_validator_rc=1

on_exit() {
    local cmd_rc=$?
    set +e

    echo "$delta_auditor_rc" > "$WORK_DIR/delta_auditor.returncode"
    echo "$bisection_runner_rc" > "$WORK_DIR/bisection_runner.returncode"
    echo "$f38_entrypoint_rc" > "$WORK_DIR/f38_entrypoint.returncode"

    # Step 1: Validate F38 matrix results and write f38_matrix_validator.returncode
    python3 "$WORK_DIR/runtime/validate_f38_matrix_results.py" "$WORK_DIR"
    f38_matrix_validator_rc=$?
    echo "$f38_matrix_validator_rc" > "$WORK_DIR/f38_matrix_validator.returncode"

    # Step 2: Run runtime validator and write runtime_validator.returncode
    python3 "$WORK_DIR/runtime/validate_f40_runtime_audits.py" "$WORK_DIR"
    runtime_validator_rc=$?
    echo "$runtime_validator_rc" > "$WORK_DIR/runtime_validator.returncode"

    # Step 3: Write preliminary first_failure.returncode
    local first_failure=0
    if [ "$cmd_rc" -ne 0 ]; then
        first_failure=$cmd_rc
    elif [ "$delta_auditor_rc" -ne 0 ]; then
        first_failure=$delta_auditor_rc
    elif [ "$bisection_runner_rc" -ne 0 ]; then
        first_failure=$bisection_runner_rc
    elif [ "$f38_entrypoint_rc" -ne 0 ]; then
        first_failure=$f38_entrypoint_rc
    elif [ "$f38_matrix_validator_rc" -ne 0 ]; then
        first_failure=$f38_matrix_validator_rc
    elif [ "$runtime_validator_rc" -ne 0 ]; then
        first_failure=$runtime_validator_rc
    fi
    echo "$first_failure" > "$WORK_DIR/first_failure.returncode"

    # Step 4: Generate missing evidence report after all return codes exist
    python3 "$WORK_DIR/runtime/generate_missing_evidence_report.py" "$WORK_DIR" >/dev/null 2>&1
    local col_rc=$?
    echo "$col_rc" > "$WORK_DIR/collector.returncode"

    if [ "$first_failure" -eq 0 ] && [ "$col_rc" -ne 0 ]; then
        first_failure=$col_rc
    fi

    local overall_cls="f40_generic_cae_primitives_passed_runtime_evidence_contract_failed"
    if [ "$first_failure" -eq 0 ]; then
        overall_cls="f40_bisection_completed_successfully"
    fi

    cat <<EOF > "$WORK_DIR/STATUS.json"
{
  "timestamp": "$(date -u +'%Y-%m-%dT%H:%M:%S')",
  "delta_auditor_rc": $delta_auditor_rc,
  "bisection_runner_rc": $bisection_runner_rc,
  "f38_entrypoint_rc": $f38_entrypoint_rc,
  "f38_matrix_validator_rc": $f38_matrix_validator_rc,
  "runtime_validator_rc": $runtime_validator_rc,
  "collector_rc": $col_rc,
  "first_failure_rc": $first_failure,
  "overall_classification": "$overall_cls"
}
EOF

    echo "$first_failure" > "$WORK_DIR/first_failure.returncode"

    cp -f "$WORK_DIR"/*.json "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    cp -f "$WORK_DIR"/*.returncode "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    cp -f "$WORK_DIR"/*.txt "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    if [ -n "${PBS_JOBID:-}" ]; then
        cp -f "$PBS_O_WORKDIR/M2RMBISECT1.o${PBS_JOBID}" "$F40_EVIDENCE_DIR/" 2>/dev/null || true
        cp -f "$PBS_O_WORKDIR/M2RMBISECT1.e${PBS_JOBID}" "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    fi

    trap - EXIT
    exit "$first_failure"
}

trap on_exit EXIT

echo "=== F40 Launcher Diagnostic Bisection Batch Execution ==="
echo "Host: $CURRENT_FULL_HOST"
echo "Date: $(date)"
echo "Work dir: $WORK_DIR"
echo "Package dir: $F40_PACKAGE_DIR"
echo "Evidence dir: $F40_EVIDENCE_DIR"

cd "$F40_PACKAGE_DIR"
sha256sum -c SHA256SUMS
sha256sum -c F40_SHA256SUMS
cd "$WORK_DIR"

module purge || true
module load abaqus/2023 || { echo "FATAL: abaqus/2023 module load failed" >&2; exit 1; }
command -v abaqus >/dev/null 2>&1 || { echo "FATAL: abaqus executable not found on PATH" >&2; exit 1; }

ABAQUS_RELEASE=$(abaqus information=release 2>&1) || {
    echo "FATAL: Abaqus release query failed." >&2
    exit 1
}

if ! printf '%s\n' "$ABAQUS_RELEASE" | grep -q "2023"; then
    echo "FATAL: Expected Abaqus 2023, received: $ABAQUS_RELEASE" >&2
    exit 1
fi

ABAQUS_EXECUTABLE=$(command -v abaqus)
export CURRENT_FULL_HOST CURRENT_SHORT_HOST ABAQUS_RELEASE ABAQUS_EXECUTABLE PBS_JOBID PBS_ENVIRONMENT PBS_QUEUE PBS_O_HOST

python3 - "$WORK_DIR/SCHEDULER_PROVENANCE.json" "$PBS_NODEFILE" <<'PY'
import datetime
import json
import os
import sys

output_path = sys.argv[1]
nodefile = sys.argv[2]

with open(nodefile, "r", encoding="utf-8") as handle:
    nodefile_hosts = [line.strip() for line in handle if line.strip()]

data = {
    "protocol_version": 1,
    "pbs_jobid": os.environ["PBS_JOBID"],
    "pbs_environment": os.environ["PBS_ENVIRONMENT"],
    "pbs_queue": os.environ["PBS_QUEUE"],
    "pbs_o_host": os.environ["PBS_O_HOST"],
    "hostname": os.environ["CURRENT_FULL_HOST"],
    "hostname_short": os.environ["CURRENT_SHORT_HOST"],
    "nodefile": nodefile,
    "nodefile_hosts": nodefile_hosts,
    "abaqus_executable": os.environ["ABAQUS_EXECUTABLE"],
    "abaqus_release": os.environ["ABAQUS_RELEASE"],
    "timestamp_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
}

with open(output_path, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
PY

echo "=== Stage 1: Contract Delta Auditor ==="
python3 "$F40_PACKAGE_DIR/runtime/f40_invocation_contract_delta.py"
delta_auditor_rc=0

echo "=== Stage 2: Abaqus CAE Bisection Runner ==="
set +e
F40_RUNTIME_DIR="$WORK_DIR/runtime" F40_EVIDENCE_DIR="$F40_EVIDENCE_DIR" abaqus cae noGUI="$WORK_DIR/runtime/f40_cae_bisection_runner.py"
bisection_runner_rc=$?
set -e

echo "=== Stage 3: Exact F38 Entrypoint Execution ==="
set +e
F40_RUNTIME_DIR="$WORK_DIR/runtime" F38_RUNTIME_DIR="$WORK_DIR/runtime" F40_INVOCATION_AUDIT="$WORK_DIR/CAE_INVOCATION_CONTEXT_AUDIT.json" F38_INVOCATION_AUDIT="$WORK_DIR/CAE_INVOCATION_CONTEXT_AUDIT.json" F40_DIAGNOSTIC_MATRIX="$WORK_DIR/CAE_PHASE_DIAGNOSTIC_MATRIX.json" F38_DIAGNOSTIC_MATRIX="$WORK_DIR/CAE_PHASE_DIAGNOSTIC_MATRIX.json" abaqus cae noGUI="$WORK_DIR/runtime/run_f38_cae_diagnostic.py"
f38_entrypoint_rc=$?
set -e

echo "=== F40 Execution Finished (bisection_rc=$bisection_runner_rc, entrypoint_rc=$f38_entrypoint_rc) ==="
