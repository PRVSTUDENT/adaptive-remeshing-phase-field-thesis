#!/bin/bash
#PBS -N M2RMBISECT1
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -Eeuo pipefail

F40_PACKAGE_DIR="${F40_PACKAGE_DIR:?F40_PACKAGE_DIR must be exported by launcher}"
F40_EVIDENCE_DIR="${F40_EVIDENCE_DIR:-${PBS_O_WORKDIR:-$(pwd)}/runs/hpc/stage_f/f40_f38_cae_invocation_model_building_bisect/evidence}"

WORK_DIR="${PBS_O_WORKDIR:-$(pwd)}/runs/hpc/stage_f/f40_f38_cae_invocation_model_building_bisect/M2RMBISECT1_${PBS_JOBID:-local}"
mkdir -p "$WORK_DIR" "$F40_EVIDENCE_DIR"
cd "$WORK_DIR"

mkdir -p "$WORK_DIR/runtime"
cp "$F40_PACKAGE_DIR/runtime/"* "$WORK_DIR/runtime/"

delta_auditor_rc=1
bisection_runner_rc=1
f38_entrypoint_rc=1
runtime_validator_rc=1

on_exit() {
    local cmd_rc=$?
    set +e

    echo "$delta_auditor_rc" > "$WORK_DIR/delta_auditor.returncode"
    echo "$bisection_runner_rc" > "$WORK_DIR/bisection_runner.returncode"
    echo "$f38_entrypoint_rc" > "$WORK_DIR/f38_entrypoint.returncode"

    # Step 1: Write preliminary STATUS.json
    local overall_cls="f40_generic_cae_primitives_passed_runtime_evidence_contract_failed"
    cat <<EOF > "$WORK_DIR/STATUS.json"
{
  "timestamp": "$(date -u +'%Y-%m-%dT%H:%M:%S')",
  "delta_auditor_rc": $delta_auditor_rc,
  "bisection_runner_rc": $bisection_runner_rc,
  "f38_entrypoint_rc": $f38_entrypoint_rc,
  "runtime_validator_rc": $runtime_validator_rc,
  "first_failure_rc": $cmd_rc,
  "overall_classification": "$overall_cls"
}
EOF

    # Step 2: Generate missing evidence report (for finalized evidence files)
    python3 "$WORK_DIR/runtime/generate_missing_evidence_report.py" "$WORK_DIR" >/dev/null 2>&1
    local col_rc=$?
    echo "$col_rc" > "$WORK_DIR/collector.returncode"

    # Step 3: Run runtime validator
    python3 "$WORK_DIR/runtime/validate_f40_runtime_audits.py" "$WORK_DIR"
    runtime_validator_rc=$?
    echo "$runtime_validator_rc" > "$WORK_DIR/runtime_validator.returncode"

    # Step 4: Compute final first_failure
    local first_failure=0
    if [ "$cmd_rc" -ne 0 ]; then
        first_failure=$cmd_rc
    elif [ "$delta_auditor_rc" -ne 0 ]; then
        first_failure=$delta_auditor_rc
    elif [ "$bisection_runner_rc" -ne 0 ]; then
        first_failure=$bisection_runner_rc
    elif [ "$f38_entrypoint_rc" -ne 0 ]; then
        first_failure=$f38_entrypoint_rc
    elif [ "$col_rc" -ne 0 ]; then
        first_failure=$col_rc
    elif [ "$runtime_validator_rc" -ne 0 ]; then
        first_failure=$runtime_validator_rc
    fi

    if [ "$first_failure" -eq 0 ]; then
        overall_cls="f40_bisection_completed_successfully"
    else
        overall_cls="f40_generic_cae_primitives_passed_runtime_evidence_contract_failed"
    fi

    cat <<EOF > "$WORK_DIR/STATUS.json"
{
  "timestamp": "$(date -u +'%Y-%m-%dT%H:%M:%S')",
  "delta_auditor_rc": $delta_auditor_rc,
  "bisection_runner_rc": $bisection_runner_rc,
  "f38_entrypoint_rc": $f38_entrypoint_rc,
  "runtime_validator_rc": $runtime_validator_rc,
  "first_failure_rc": $first_failure,
  "overall_classification": "$overall_cls"
}
EOF

    echo "$first_failure" > "$WORK_DIR/first_failure.returncode"

    cp -f "$WORK_DIR"/*.json "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    cp -f "$WORK_DIR"/*.returncode "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    cp -f "$WORK_DIR"/*.txt "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    if [ -n "${PBS_JOBID:-}" ]; then
        cp -f "$PBS_O_WORKDIR/M2RMBISECT1.o${PBS_JOBID}" "$F40_EVIDENCE_DIR/" 2>/dev/null || true
        cp -f "$PBS_O_WORKDIR/M2RMBISECT1.e${PBS_JOBID}" "$F40_EVIDENCE_DIR/" 2>/dev/null || true
    fi

    trap - EXIT
    exit "$first_failure"
}

trap on_exit EXIT

echo "=== F40 Launcher Diagnostic Bisection Batch Execution ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Work dir: $WORK_DIR"
echo "Package dir: $F40_PACKAGE_DIR"
echo "Evidence dir: $F40_EVIDENCE_DIR"

cd "$F40_PACKAGE_DIR"
sha256sum -c SHA256SUMS
sha256sum -c F40_SHA256SUMS
cd "$WORK_DIR"

module purge || true
module load abaqus/2023 || true

echo "=== Stage 1: Contract Delta Auditor ==="
python3 "$F40_PACKAGE_DIR/runtime/f40_invocation_contract_delta.py"
delta_auditor_rc=0

echo "=== Stage 2: Abaqus CAE Bisection Runner ==="
set +e
F40_RUNTIME_DIR="$WORK_DIR/runtime" F40_EVIDENCE_DIR="$F40_EVIDENCE_DIR" abaqus cae noGUI="$WORK_DIR/runtime/f40_cae_bisection_runner.py"
bisection_runner_rc=$?
set -e

echo "=== Stage 3: Exact F38 Entrypoint Execution ==="
set +e
F40_RUNTIME_DIR="$WORK_DIR/runtime" F38_RUNTIME_DIR="$WORK_DIR/runtime" F40_INVOCATION_AUDIT="$WORK_DIR/CAE_INVOCATION_CONTEXT_AUDIT.json" F38_INVOCATION_AUDIT="$WORK_DIR/CAE_INVOCATION_CONTEXT_AUDIT.json" F40_DIAGNOSTIC_MATRIX="$WORK_DIR/CAE_PHASE_DIAGNOSTIC_MATRIX.json" F38_DIAGNOSTIC_MATRIX="$WORK_DIR/CAE_PHASE_DIAGNOSTIC_MATRIX.json" abaqus cae noGUI="$WORK_DIR/runtime/run_f38_cae_diagnostic.py"
f38_entrypoint_rc=$?
set -e

echo "=== F40 Execution Finished (bisection_rc=$bisection_runner_rc, entrypoint_rc=$f38_entrypoint_rc) ==="
