#!/bin/bash
#PBS -N M2REF_H0_FRACFIX_REPRO
#PBS -l select=1:ncpus=1:mem=8 GB
#PBS -l walltime=01:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -o evidence/$PBS_JOBID/execution.log

set -euo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p evidence/"$PBS_JOBID"

echo "=== Host Environment ==="
hostname
date
module list || true

module load gcc/11.4.0 intel/2024.2.0 abaqus/2023 python/gcc/11.4.0/3.11.7

echo "=== Running Abaqus Job M2REF_H0_FRACFIX_REPRO ==="
abaqus job=M2REF_H0_FRACFIX_REPRO input=M2REF_H0_FRACFIX_REPRO.inp user=f42_mixed_uel.for cpus=1 interactive double=both ask_delete=OFF

echo "=== Execution Complete ==="
date
