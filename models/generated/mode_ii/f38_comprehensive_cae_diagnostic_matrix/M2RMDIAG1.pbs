#!/usr/bin/env bash
#PBS -N M2RMDIAG1
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m abe

set -euo pipefail

export OMP_NUM_THREADS=1
export OPENMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

F38_PACKAGE_DIR="${F38_PACKAGE_DIR:-$PBS_O_WORKDIR}"
F38_EVIDENCE_DIR="${F38_EVIDENCE_DIR:-$F38_PACKAGE_DIR/../../../../runs/hpc/stage_f/f38_comprehensive_cae_diagnostic/evidence}"

mkdir -p "$F38_EVIDENCE_DIR"

WORK_DIR="/scratch/pr21vyci/adaptive-remeshing/runs/stage_f/f38_comprehensive_cae_diagnostic_matrix_${PBS_JOBID:-local}"

mkdir -p "$WORK_DIR"
cd "$WORK_DIR"

echo "Staging F38 package files into WORK_DIR..."
cp -r "$F38_PACKAGE_DIR"/* .
cp "$F38_PACKAGE_DIR/M2RMDIAG1.pbs" .

echo "Verifying SHA256SUMS..."
sha256sum -c SHA256SUMS

module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023

command -v python3 >/dev/null 2>&1 || { echo "python3 not found"; exit 1; }
python3 --version

export F38_RUNTIME_DIR="$WORK_DIR/runtime"
export F38_SOURCE_DECK="$WORK_DIR/runtime/source_deck.inp"
export F38_OUTPUT_INPUT="$WORK_DIR/generated_model.inp"
export F38_DIAGNOSTIC_MATRIX="$WORK_DIR/CAE_PHASE_DIAGNOSTIC_MATRIX.json"
export F38_INVOCATION_AUDIT="$WORK_DIR/CAE_INVOCATION_CONTEXT_AUDIT.json"
export F38_RUNTIME_FAILURE_AUDIT="$WORK_DIR/RUNTIME_FAILURE_AUDIT.json"

python_probe_rc="skipped"
cae_diagnostic_rc="skipped"
runtime_val_rc="skipped"
collector_rc=0

on_exit() {
    local first_failure=$?
    set +e
    echo "Executing on_exit trap with exit_code=$first_failure..."

    # 1. Write return codes first
    echo "$python_probe_rc" > python_probe.returncode
    echo "$cae_diagnostic_rc" > cae_diagnostic.returncode
    echo "$runtime_val_rc" > runtime_validator.returncode
    echo "$first_failure" > first_failure.returncode

    # 2. Copy evidence to F38_EVIDENCE_DIR
    local collect_fail_count=0
    for f in CAE_PHASE_DIAGNOSTIC_MATRIX.json CAE_INVOCATION_CONTEXT_AUDIT.json RUNTIME_FAILURE_AUDIT.json \
             COMPATIBILITY_AUDIT.json EXECUTION_COUNTERS.json \
             python_probe.returncode cae_diagnostic.returncode runtime_validator.returncode \
             first_failure.returncode generated_model.inp abaqus.rpy; do
        if [ -f "$f" ]; then
            cp "$f" "$F38_EVIDENCE_DIR/" || collect_fail_count=$((collect_fail_count + 1))
        fi
    done

    collector_rc=$collect_fail_count
    echo "$collector_rc" > collector.returncode
    cp collector.returncode "$F38_EVIDENCE_DIR/" || true

    # 3. Determine classification and write STATUS.json
    local status_str="cae_geometry_build_contract_failed"
    if [ "$cae_diagnostic_rc" = "0" ] && [ "$runtime_val_rc" = "0" ] && [ "$first_failure" -eq 0 ]; then
        status_str="cae_geometry_build_contract_passed"
    fi

    cat <<EOF > STATUS.json
{
  "protocol_version": 1,
  "task_id": "F38-CLOSE-M2RMBUILD11-AND-PREPARE-COMPREHENSIVE-CAE-DIAGNOSTIC",
  "job_name": "M2RMDIAG1",
  "classification": "$status_str",
  "python_probe_returncode": "$python_probe_rc",
  "cae_diagnostic_returncode": "$cae_diagnostic_rc",
  "runtime_validator_returncode": "$runtime_val_rc",
  "collector_returncode": "$collector_rc",
  "exit_code": "$first_failure"
}
EOF

    # 4. Copy STATUS.json to F38_EVIDENCE_DIR
    cp STATUS.json "$F38_EVIDENCE_DIR/" || true

    # 5. Generate missing-evidence report LAST
    if [ -f "$WORK_DIR/runtime/generate_missing_evidence_report.py" ]; then
        python3 "$WORK_DIR/runtime/generate_missing_evidence_report.py" "$F38_EVIDENCE_DIR" || true
        if [ -f "$WORK_DIR/MISSING_EVIDENCE_REPORT.json" ]; then
            cp "$WORK_DIR/MISSING_EVIDENCE_REPORT.json" "$F38_EVIDENCE_DIR/" || true
        fi
    fi
}

trap on_exit EXIT

set +e
abaqus python -c "import sys; print('Abaqus Python release:', sys.version)"
python_probe_rc=$?
set -e

if [ "$python_probe_rc" != "0" ]; then
    echo "ERROR: Abaqus Python probe failed with code $python_probe_rc"
    exit 1
fi

set +e
abaqus cae noGUI="$WORK_DIR/runtime/run_f38_cae_diagnostic.py"
cae_diagnostic_rc=$?
set -e

if [ "$cae_diagnostic_rc" != "0" ]; then
    echo "ERROR: Abaqus CAE diagnostic failed with code $cae_diagnostic_rc"
    exit 1
fi

# Run packaged runtime validator
set +e
python3 "$WORK_DIR/runtime/validate_f38_runtime_audits.py" "$WORK_DIR"
runtime_val_rc=$?
set -e

if [ "$runtime_val_rc" != "0" ]; then
    echo "ERROR: Runtime validator failed with code $runtime_val_rc"
    exit 1
fi

echo "M2RMDIAG1 script completed successfully."
