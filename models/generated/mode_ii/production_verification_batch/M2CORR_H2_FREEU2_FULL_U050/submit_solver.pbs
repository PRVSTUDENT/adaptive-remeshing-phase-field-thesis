#!/bin/bash
#PBS -N M2CORR_H2_FREEU2
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=24:00:00
#PBS -q entry_imfdfkmq
#PBS -m abe
#PBS -M Pruthviraja.Reddy-Vandavagali@student.tu-freiberg.de,pr21vyci@mailserver.tu-freiberg.de
#PBS -o M2CORR_H2_FREEU2.out
#PBS -e M2CORR_H2_FREEU2.err

cd $PBS_O_WORKDIR

# STORAGE COMPLIANCE GUARD: Reject execution under /home
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
    echo "[STORAGE COMPLIANCE ERROR] Direct execution in /home filesystem is rejected by storage policy." >&2
    echo "Please execute solver jobs strictly from /scratch/pr21vyci/projects/adaptive-remeshing/ or /scratch9/." >&2
    exit 88
fi


# Clean old locks
rm -f *.lck

# Fail-closed Dual-Channel Notifications
if [ -f "$HOME/projects/adaptive-remeshing/scripts/hpc/notifications/job_notifications.sh" ]; then
    source "$HOME/projects/adaptive-remeshing/scripts/hpc/notifications/job_notifications.sh"
    notification_install_terminal_trap
    notify_start "M2CORR_H2_FREEU2"
fi

module purge
module load gcc/11.4.0
module load intel/2024.2.0
module load abaqus/2023

echo "=== STARTING PRODUCTION SOLVER M2CORR_H2_FREEU2 ==="
abaqus job=M2CORR_H2_FREEU2_FULL_U050 input=M2CORR_H2_FREEU2_FULL_U050.inp user=f42_mixed_uel_transactional.for cpus=1 interactive
ABAQUS_RC=$?

echo "=== FINISHED PRODUCTION SOLVER M2CORR_H2_FREEU2 (EXIT: ${ABAQUS_RC}) ==="
exit ${ABAQUS_RC}
