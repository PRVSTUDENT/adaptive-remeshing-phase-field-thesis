\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Mode-I benchmark boundary value problem: $1.0\,\mathrm {mm} \times 1.0\,\mathrm {mm}$ square domain with a sharp edge crack of length $a_0 = 0.5\,\mathrm {mm}$ at $y = 0.5\,\mathrm {mm}$. Boundary conditions prescribe roller support ($u_y = 0$) along the bottom edge with a pinned point ($u_x = 0$) to eliminate rigid-body translation, and uniform tensile displacement $u_y = u$ on the top boundary.}}{5}{figure.caption.7}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Force--displacement comparison between the canonical fixed-mesh $S_1$ reference ($15{,}192$ finite elements) and the corrected native-adaptive $A_1$ model with \texttt {errorTarget = 1\%} ($71{,}320$ finite elements). The initial structural stiffness differs by only $0.09\%$, while the adaptive peak reaction force is approximately $1.64\%$ below the reference value.}}{8}{figure.caption.11}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Schematic of the Pandey--Kumar two-job adaptive pre-refinement workflow: a linear-elastic pre-analysis on a coarse grid generates the \texttt {MISESERI} error indicator field, which drives Abaqus native \texttt {adaptiveRemesh} before reconstructing the multi-layer UEL/UMAT phase-field model for the full fracture calculation.}}{9}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Defensible qualitative interpretation of \texttt {MISESERI} under uniform-error sizing: high recovered stress gradients near geometric singularities drive local element refinement; this relationship is directional and does not imply a simple algebraic formula from \texttt {MISESERI} directly to element size.}}{10}{figure.caption.13}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Canonical Mode-I \texttt {MISESERI} error indicator field evaluated on the 2,906-element coarse mesh. High error concentrations cluster around the initial sharp crack tip ($x = 0.5\,\mathrm {mm}, y = 0.5\,\mathrm {mm}$), defining the targeted refinement zone.}}{11}{figure.caption.14}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Comparison between (a) the initial coarse mesh ($2{,}906$ finite elements) and (b) the resulting error-guided adapted mesh ($71{,}320$ finite elements) generated by Abaqus native \texttt {adaptiveRemesh}.}}{11}{figure.caption.15}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Observed spatial association between coarse \texttt {MISESERI} error indicator values and the adapted local finite element edge length $h$. Regions with higher stress discretization error receive refined element sizes.}}{12}{figure.caption.16}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Global energy evolution and two-term bookkeeping difference for baseline Case $S_1$ ($15{,}192$ mesh cells / $45{,}576$ Abaqus element objects). In the linear-elastic regime ($u < 0.005\,\mathrm {mm}$), $W_{\mathrm {ext}} = E_{\mathrm {elas}}$ with relative difference $< 10^{-4}\,\%$. During post-peak crack propagation, stored elastic strain energy converts into fracture surface energy, satisfying $W_{\mathrm {ext}} \approx E_{\mathrm {frac}}$ with terminal difference $\mathcal {R}_{\mathrm {bookkeeping}} < 0.77\,\%$.}}{18}{figure.caption.22}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Mode-I tensile force-displacement response for the spatial fixed-mesh series ($S_1$--$S_4$). Incomplete cases ($S_2, S_3, S_4$) terminate at their real post-peak cutback states ($u = 6.82, 7.84, 7.21\,\mu \mathrm {m}$, marked by circles). All cases reproduce identical linear-elastic stiffness ($K_0 \approx 137.9\,\mathrm {kN/mm}$); peak load shows systematic mesh sensitivity.}}{21}{figure.caption.23}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Spatial convergence metrics as a function of discretization ratio $h/l_0$: (a) initial structural stiffness $K_0$ is exceptionally stable ($\Delta < 0.09\%$); (b) peak force $F_{\max }$ exhibits monotonic mesh sensitivity ($4.26\%$ variation); (c) peak displacement $u_{\mathrm {peak}}$ decreases from $5.86\,\mu \mathrm {m}$ to $5.58\,\mu \mathrm {m}$.}}{22}{figure.caption.24}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Three-point physical length-scale study on fixed $S_3$ mesh ($h = 1.5\,\mu \mathrm {m}$): (a) global force-displacement overlay and (b) variation of $K_0$, $F_{\max }$, $u_{\mathrm {peak}}$, and matched $W_{\mathrm {trap}}$ at $u = 5.50\,\mu \mathrm {m}$ with $l_0$.}}{22}{figure.caption.27}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Mode-I temporal convergence across time increment scales ($T_1$: coarse $2\times $, $T_2$: nominal $1\times $, $T_3$: fine $0.5\times $, Job \texttt {1406317}). The mechanical peak response is virtually identical ($F_{\max } \in [0.7576, 0.7582]\,\mathrm {kN}$, spread $< 0.07\%$).}}{24}{figure.caption.28}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Temporal discretization scaling of global energy components across schedules $T_1$ ($2\times $), $T_2$ ($1\times $), and $T_3$ ($0.5\times $, Job \texttt {1406317}) on fixed $S_1$ mesh: (a) boundary work $W_{\mathrm {trap}}(u)$; (b) stored elastic energy $E_{\mathrm {elas}}(u)$; (c) fracture surface energy $E_{\mathrm {frac}}(u)$; (d) two-term bookkeeping difference $\mathcal {R}_{\mathrm {bookkeeping}}(u)$.}}{25}{figure.caption.29}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Abaqus-native adaptive meshes generated for the Mode-I benchmark using \texttt {errorTarget} values of (a) 1\%, (b) 2\%, (c) 3\%, and (d) 5\%. The corresponding production meshes contain $71{,}320$, $15{,}396$, $7{,}633$, and $4{,}194$ underlying finite elements, respectively. Full-domain views and identical crack-tip zooms illustrate how relaxing the target error changes the spatial refinement distribution.}}{26}{figure.caption.30}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Force--displacement response of the canonical uniform reference $S_1$ and native adaptive meshes $A_1$--$A_4$: (a) full response over $u \in [0, 10]\,\mu \mathrm {m}$; (b) post-peak zoom over $u \in [5.4, 10]\,\mu \mathrm {m}$. Production adaptive meshes contain $71{,}320$, $15{,}396$, $7{,}633$, and $4{,}194$ underlying finite elements for \texttt {errorTarget} values of 1\%, 2\%, 3\%, and 5\%, respectively. $A_1$ terminates at $u = 6.77\,\mu \mathrm {m}$, whereas $A_2$--$A_4$ reach $10\,\mu \mathrm {m}$.}}{27}{figure.caption.31}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Matched-displacement phase-field damage contours comparing canonical reference $S_1$ ($15{,}192$ elements) and corrected native adaptive meshes $A_1$--$A_4$ across deformation states: (a) initiation at $u=5.00\,\mu \mathrm {m}$; (b) pre-peak concentration at $u=5.50\,\mu \mathrm {m}$; (c) peak / crack initiation at $u\approx 5.85\,\mu \mathrm {m}$; (d) post-peak propagated crack at $u=6.20\,\mu \mathrm {m}$.}}{28}{figure.caption.32}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Visual evolution of Mode-I crack propagation for the canonical $S_1$ reference baseline: six-stage sequence from initial elastic localization ($u = 5.0\,\mu \mathrm {m}$) through peak load ($u = 5.857\,\mu \mathrm {m}$) to complete ligament separation ($u = 6.20\,\mu \mathrm {m}$).}}{29}{figure.caption.33}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Spatial phase-field ligament profiles $d(x, y=0.5\,\mathrm {mm})$ for fixed meshes $S_1$--$S_4$ across matched displacement levels, showing x-axis coordinates on all panels and annotating full boundary propagation in $S_1$ at $u = 6.20\,\mu \mathrm {m}$.}}{30}{figure.caption.34}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Spatial phase-field ligament profiles $d(x, y=0.5\,\mathrm {mm})$ comparing canonical reference $S_1$ against native adaptive meshes $A_1$--$A_4$ across matched displacement levels.}}{31}{figure.caption.35}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Rigorous separation of crack-centroid trajectory and damage localization band width: (a) damage-weighted crack-centroid vertical deviation $|y_c - 0.5\,\mathrm {mm}| \le 3.1\,\mu \mathrm {m}$ across all meshes confirms strict Mode-I symmetry within element bounds; (b) regularized damage localization-band half-width for $d \ge 0.50$ ($10$--$15\,\mu \mathrm {m}$, total full-width $20.0$--$30.0\,\mu \mathrm {m}$ overall, $20.0$--$22.9\,\mu \mathrm {m}$ at $x=0.55\,\mathrm {mm}$, mesh-sensitive and resolution-limited).}}{32}{figure.caption.36}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Early mechanical response parity between the corrected Stage~14 adaptive candidate (Job \texttt {1409953}, 14,483 elements) and the qualified fixed reference benchmark (Job \texttt {1409734}, 15,192 elements). Left: Reaction force $F = -RF_2$ versus displacement $u$ along the initial elastic branch with solver running watermark. Right: Pointwise relative force discrepancy $\Delta F / F_{\mathrm {ref}}$ [\%] demonstrating $\le 0.03\%$ parity across all evaluated increments.}}{39}{figure.caption.41}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Canonical structural stiffness ($K_0$) linear regression across the frozen $N=400$ increment window ($u \in (0.00125, \, 1.00125]\,\mu \mathrm {m}$). Top: Comparison of reaction force $F = -RF_2$ between the fixed reference benchmark (Job \texttt {1409734}) and adaptive solve (Job \texttt {1409953}) with OLS linear fit. Bottom: Pointwise relative discrepancy $(F_{\mathrm {adapt}} - F_{\mathrm {ref}})/F_{\mathrm {ref}}$ [\%] demonstrating sub-$0.05\%$ tracking across the entire initial elastic regime.}}{42}{figure.caption.43}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Multi-state spatial phase-field damage profile overlay $d(x)$ along the Mode-I symmetry ligament ($y = 0.500\,\mathrm {mm}$, $x \in [0.50, 0.70]\,\mathrm {mm}$) at $u = 1.0\,\mu \mathrm {m}$ (Frame~400) and $u = 3.0\,\mu \mathrm {m}$ (Frame~1200). The adaptive candidate (\texttt {1409953}) demonstrates consistent localization morphology and identical far-field decay compared to the fixed reference (\texttt {1409734}).}}{45}{figure.caption.46}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Near-tip localization and discrepancy evolution across states $u = 1.0\,\mu \mathrm {m}$ and $u = 3.0\,\mu \mathrm {m}$: (a) discrete element centroid sampling near the notch root illustrating the effect of finer adaptive sizing ($h_{\min } \approx 1.09\,\mu \mathrm {m}$ vs $1.97\,\mu \mathrm {m}$), and (b) spatial discrepancy profile $\Delta d(x) = d_{\mathrm {adapt}}(x) - d_{\mathrm {ref}}(x)$ peaking at the notch root and vanishing in the far field alongside damage gradient magnitude $|\nabla d(x)|$.}}{45}{figure.caption.47}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Grid-resolution invariance audit across sampling densities $\Delta x \in \{1.0, 0.5, 0.25\}\,\mu \mathrm {m}$ ($N=501, 1001, 2001$), demonstrating that continuous relative $L_2$ error (left) and $L_\infty $ peak discrepancy (right) are invariant to postprocessing interpolation grids.}}{46}{figure.caption.48}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Stage 14U-P mechanical response overlay between predecessor baseline Job \texttt {1409953} ($I_A=5$) and active completion Job \texttt {1409982} ($I_A=10$) across the initial elastic window, demonstrating exact curve superposition.}}{56}{figure.caption.54}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Stage 14U-P point-by-point solution discrepancy between Job \texttt {1409982} and Job \texttt {1409953}. Top: Absolute reaction force difference $|\Delta F|$ [$\mathrm {kN}$]. Bottom: Relative force error $|\Delta F|/F_{\mathrm {pred}}$ [\%], showing sub-$0.002\%$ variation governed purely by file export precision.}}{57}{figure.caption.55}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Energy partitioning and evolution comparison between Package~24 (13.9k elements, 12.2\% corridor share) and Stage~14 (14.5k elements, 57.5\% corridor share). Both models exhibit identical pre-peak stored elastic energy ($E_{\mathrm {elas}}$) and crack-surface functional ($E_{\mathrm {frac}}$) up to $u = 5.0\,\mu \mathrm {m}$. In the post-peak softening regime, Stage~14 undergoes rapid snap-through and unloads elastically to $E_{\mathrm {elas}} \le 0.007\,\mathrm {mJ}$, while Package~24 exhibits delayed breakthrough with spurious elastic retention across coarse corridor elements.}}{72}{figure.caption.62}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Reaction force vs.\ prescribed displacement ($F-u$) response comparison between Package~24 ($F_{\max } = 0.7423\,\mathrm {kN}$, $u_{\mathrm {peak}} = 5.721\,\mu \mathrm {m}$) and Stage~14 ($F_{\max } = 0.7437\,\mathrm {kN}$, $u_{\mathrm {peak}} = 5.733\,\mu \mathrm {m}$). Pre-peak and peak mechanics match within $0.054\%$, while post-peak softening reflects the differing spatial element concentration across the ligament.}}{73}{figure.caption.63}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Mode-I Reaction Force vs.\ Prescribed Displacement ($F-u$) response comparison across phase-field regularization length scales ($l_0 = 7.50, 11.25, 15.00\,\mu \mathrm {m}$ on identical 42k-element meshes alongside the $S_1$ reference anchor). Initial elastic stiffness is invariant, while peak reaction force decreases monotonically with increasing $l_0$.}}{77}{figure.caption.70}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Energy evolution and partitioning dynamics across phase-field length scales: (a) Elastic strain energy storage $E_{\mathrm {elas}}(u)$; (b) Phase-field crack-surface functional $E_{\mathrm {frac}}(u)$. Pre-peak functional growth increases with $l_0$ due to broader regularization zones, while broken-state functional evaluates to $\sim 2.30\text {--}2.36\,\mathrm {mJ}$.}}{77}{figure.caption.71}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces Peak reaction force $F_{\max }$ as a function of regularization length scale $l_0$ on the 42k structured mesh. Peak force decreases monotonically from $0.7255\,\mathrm {kN}$ to $0.6895\,\mathrm {kN}$ ($-4.96\%$), reflecting regularized diffuse fracture mechanics scaling.}}{78}{figure.caption.72}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces Discrepancy diagnostics between baseline and completion rerun across 3,198 increments: (a) Absolute force discrepancy $|\Delta F| \le 3.0 \times 10^{-8}\,\mathrm {kN}$; (b) Relative force discrepancy $|\Delta F|/F \le 0.0013\%$. The discrepancy is strictly governed by ASCII formatting precision with zero numerical bifurcation.}}{80}{figure.caption.77}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Mode-I Load-Displacement ($F-u$) overlay between the predecessor adaptive solve (dashed magenta) and the active completion rerun (solid blue). Both models track the identical equilibrium path through linear elasticity, crack initiation, and the adaptive peak ($F_{\max } = 0.7437\,\mathrm {kN}$).}}{81}{figure.caption.78}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Energy evolution and bookkeeping residual across the reached displacement range for the completion rerun: stored elastic strain energy $E_{\mathrm {elas}}$, phase-field crack-surface functional $E_{\mathrm {frac}}$, external work $W_{\mathrm {ext}}$, and bookkeeping residual $\varepsilon _{\mathrm {book}} = |W_{\mathrm {ext}} - (E_{\mathrm {elas}} + E_{\mathrm {frac}})| / W_{\mathrm {ext}}$.}}{82}{figure.caption.81}%
