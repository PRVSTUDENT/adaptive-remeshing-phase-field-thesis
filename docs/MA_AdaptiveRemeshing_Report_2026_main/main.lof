\contentsline {figure}{\numberline {4.33}{\ignorespaces Stage 14U-AH convergence criteria reconstruction for Increment 2890}}{99}{figure.caption.105}%
\contentsline {figure}{\numberline {4.34}{\ignorespaces Stage 14U-AJ 4-thread shared-memory terminal parity audit}}{103}{figure.caption.108}%
\contentsline {figure}{\numberline {4.35}{\ignorespaces Stage 14U-AJ parallel scaling and Increment 2890 attempt sequence parity}}{104}{figure.caption.110}%
\contentsline {figure}{\numberline {4.36}{\ignorespaces Stage 14U-AK Stage-B determinism repeat and temporal diagnostic advancement}}{106}{figure.caption.112}%
\contentsline {figure}{\numberline {4.37}{\ignorespaces Stage 14U-AN 4-Thread Shared-Memory Parallel Determinism and Scaling: (a) Overlaid $F-u$ curves proving bitwise identical response across 1-CPU serial baseline, 4-thread Stage-A, and 4-thread Stage-B runs; (b) Absolute reaction force difference $|\Delta F| \le 10^{-8}\,\mathrm {kN}$ confirming zero numerical drift; (c) Step-by-step walltime scaling showing $2.31\times $ speedup; (d) Bitwise identical $10$-attempt Newton cutback plateau at Step~2 Inc~2890.}}{115}{figure.caption.118}%
\contentsline {figure}{\numberline {4.38}{\ignorespaces Stage 14U-AN $2\times $ Temporal Refinement Diagnostic: (a) Overlaid $F-u$ curves showing exact mechanical match through pre-peak, peak, and snap-through regimes; (b) Reaction force difference $|\Delta F| < 0.0002\,\mathrm {kN}$ up to failure; (c) Zoomed post-peak softening tail demonstrating earlier termination at $u = 0.007470\,\mathrm {mm}$ due to halved $\Delta u_{\mathrm {inc}}$ normalization; (d) Cumulative increments completed across loading steps.}}{117}{figure.caption.120}%
\contentsline {figure}{\numberline {4.39}{\ignorespaces Gate-6B Stage 14U-AP/AQ Mode-I Native Remeshing Spatial Sensitivity: Equivalent element size distribution $h_{\mathrm {eq}}(\mathbf {x})$ across $\eta _{\mathrm {target}} \in \{1.0\%, 2.0\%, 3.0\%, 5.0\%\}$ showing highlighted crack corridor boundaries ($y \in [0.45, 0.55]\,\mathrm {mm}$, shaded gray), initial notch ($a_0 = 0.50\,\mathrm {mm}$, solid red line), and uniform colorbar scaling with reference threshold $\ell _0 = 7.5\,\mu \mathrm {m}$.}}{123}{figure.caption.123}%
\contentsline {figure}{\numberline {4.40}{\ignorespaces Independent 2D Plate with Central Circular Hole Benchmark ($R=0.1\,\mathrm {mm}$): Abaqus native \texttt {adaptiveRemesh} mesh progression across $\eta _{\mathrm {target}} \in \{1.0\%, 2.0\%, 3.0\%, 5.0\%\}$. The remesher accurately captures the bilateral stress concentration lobes ($K_t \approx 3.06$) at lateral flanks $(0.4, 0.5)\,\mathrm {mm}$ and $(0.6, 0.5)\,\mathrm {mm}$ with $>91.6\%\text {--}96.0\%$ bilateral symmetry and $2.1\times \text {--}3.5\times $ local-to-far refinement contrast.}}{124}{figure.caption.124}%
\contentsline {figure}{\numberline {4.41}{\ignorespaces Independent Cross-Mode Validation of the Adaptive-Remeshing Localization Mechanism (Mode-II Pure Shear Specimen, $1.0\times 1.0\,\mathrm {mm}$, $a_0 = 0.5\,\mathrm {mm}$, $\ell _0 = 0.015\,\mathrm {mm}$): (a) Coarse 3-layer pre-analysis phase-field damage field ($d$) at $u_1 = 0.060\,\mathrm {mm}$; (b) Recovered companion error indicator field ($\mathrm {MISESERI}$) producing the inclined shear corridor ($\theta = -49.74^\circ $); (c) Native Abaqus \texttt {adaptiveRemesh} reproduction mesh ($N = 21{,}496$ elements, $+7.7\%$ vs published $19{,}963$ elements) with zero spurious branching; (d) Quantitative 4-way path trajectory and corridor overlay comparing published $\mathrm {MISESERI}$ path, published adaptive mesh corridor, phase-field crack path, and native reproduced mesh corridor.}}{130}{figure.caption.131}%
