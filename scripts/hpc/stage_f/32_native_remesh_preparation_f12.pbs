#!/bin/bash
#PBS -N M2RMPREP1
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m abe
set -uo pipefail
cd "$PBS_O_WORKDIR" || exit 2

# STORAGE COMPLIANCE GUARD: Reject execution under /home
if [[ "$(pwd -P)" =~ ^/home/ ]]; then
    echo "[STORAGE COMPLIANCE ERROR] Direct execution in /home filesystem is rejected by storage policy." >&2
    echo "Please execute solver jobs strictly from /scratch/pr21vyci/projects/adaptive-remeshing/ or /scratch9/." >&2
    exit 88
fi

module purge
module load gcc/11.4.0 intel/2024.2.0 abaqus/2023
sha256sum -c SHA256SUMS || exit 3
export F12_RUNTIME_DIR="$PBS_O_WORKDIR/runtime"
export F12_OUTPUT_DIR="$PBS_O_WORKDIR/output"
mkdir -p "$F12_OUTPUT_DIR"
abaqus cae noGUI=runtime/prepare_stage_f12_native_remesh.py
