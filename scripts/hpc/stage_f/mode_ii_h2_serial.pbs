#!/bin/bash
#PBS -N mode_ii_h2_serial
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=12:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -uo pipefail

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

PROJECT_ROOT="${PROJECT_ROOT:-/home/pr21vyci/projects/adaptive-remeshing}"
PRESTAGED_ROOT="${PRESTAGED_ROOT:-${PROJECT_ROOT}}"
PRESTAGED_RUNTIME_ROOT="${PRESTAGED_RUNTIME_ROOT:-${PROJECT_ROOT}}"

JOB_NAME="mode_ii_h2_uniform_serial"
STAGE="Stage F"
TASK_ID="F3-STAGE-F3-SUBMIT"

echo "=== Mode-II H2 Uniform Reference Serial PBS Execution Start ==="
echo "PBS Job ID: ${PBS_JOBID:-local}"
echo "Host: $(hostname)"
echo "Date: $(date)"

# Load Modules
if command -v module >/dev/null 2>&1; then
  module load python/gcc/11.4.0/3.11.7 || true
  module load gcc/11.4.0 || true
  module load intel/2024.2.0 || true
  module load abaqus/2023 || true
fi

# Preflight authorization check
AUTH_FILE="${PROJECT_ROOT}/runs/hpc/stage_f/MODE_II_STAGE_F3_AUTHORIZATION_PROPOSAL.json"
if [ ! -f "${AUTH_FILE}" ]; then
  echo "ERROR: authorization file missing: ${AUTH_FILE}" >&2
  exit 1
fi

python3 -c "
import json, sys
auth = json.load(open('${AUTH_FILE}'))
if not (auth.get('execution_authorized') is True and auth.get('submission_approved') is True):
    print('ERROR: Execution not authorized in proposal JSON!', file=sys.stderr)
    sys.exit(1)
"

SCRATCH_RUN="${SCRATCH_RUN:-/scratch/pr21vyci/adaptive-remeshing/runs/mode_ii_h2_serial_${PBS_JOBID:-local}}"
mkdir -p "${SCRATCH_RUN}"
cd "${SCRATCH_RUN}"

# Package directory
PKG_DIR="${PRESTAGED_ROOT}/models/generated/mode_ii/h2_uniform_serial"
INP_FILE="${PKG_DIR}/ModeII_H2_uniform_serial.inp"
FOR_FILE="${PKG_DIR}/ModeII_H2_uniform_serial.for"

cp "${INP_FILE}" "${SCRATCH_RUN}/ModeII_H2_uniform_serial.inp"
cp "${FOR_FILE}" "${SCRATCH_RUN}/ModeII_H2_uniform_serial.for"

# Execute Abaqus
abaqus job=ModeII_H2_uniform_serial user=ModeII_H2_uniform_serial.for interactive cpus=1 mp_mode=threads double=both > ModeII_H2_uniform_serial.abaqus_stdout.log 2>&1

ABAQUS_RC=$?
echo "Abaqus Exit Code: ${ABAQUS_RC}"

# Extract evidence if available
if [ -f "${PRESTAGED_RUNTIME_ROOT}/scripts/postprocessing/extract_mode_ii_h2_results.py" ]; then
  python3 "${PRESTAGED_RUNTIME_ROOT}/scripts/postprocessing/extract_mode_ii_h2_results.py" --odb ModeII_H2_uniform_serial.odb || true
fi

echo "=== Mode-II H2 Uniform Reference Serial PBS Execution End ==="
