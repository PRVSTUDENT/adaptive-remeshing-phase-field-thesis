#!/bin/bash
#PBS -N mode_ii_h0_endpoint_corrected_datacheck
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m abe

# Stage F Mode-II H0 endpoint-corrected datacheck execution script.
# One-shot serial CPU1/16GB/00:30:00 datacheck execution; no solver run; no automatic retry.

set -uo pipefail

EVIDENCE_ROOT="${EVIDENCE_ROOT:-/home/pr21vyci/adaptive-remeshing-evidence}"
EVIDENCE_DIR="${EVIDENCE_ROOT}/stage_f/mode_ii_h0_endpoint_corrected_datacheck/${PBS_JOBID:-manual}"
PACKAGE_REL="models/generated/mode_ii/h0_endpoint_corrected_serial"
SCRATCH_RUN="${SCRATCH_RUN:-/scratch/pr21vyci/adaptive-remeshing/runs/mode_ii_h0_endpoint_corrected_datacheck_${PBS_JOBID:-manual}}"
ENV_LOG="${SCRATCH_RUN}/COMPILER_ENVIRONMENT.txt"
JOB_NAME="mode_ii_h0_endpoint_corrected_datacheck"
SOURCE_COMMIT="${PROJECT_REVISION:-unknown}"
LOGIN_MANIFEST_PATH="${LOGIN_MANIFEST_PATH:-}"

mkdir -p "${EVIDENCE_DIR}" "${SCRATCH_RUN}"
cd "${SCRATCH_RUN}" || exit 2

write_status() {
  local classification="$1"
  local abaqus_rc="$2"
  local failure="$3"
  cat > "${SCRATCH_RUN}/MODE_II_H0_ENDPOINT_CORRECTED_DATACHECK_STATUS.json" <<EOF
{
  "DATACHECK_ok": false,
  "classification": "${classification}",
  "failures": ["${failure}"],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "abaqus_return_code": ${abaqus_rc},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
}

copy_evidence() {
  mkdir -p "${EVIDENCE_DIR}"
  for pattern in \
    "${JOB_NAME}.log" "${JOB_NAME}.msg" "${JOB_NAME}.dat" "${JOB_NAME}.sta" \
    "${JOB_NAME}.com" "${JOB_NAME}.prt" "${JOB_NAME}.abaqus_stdout.log" \
    "COMPILER_ENVIRONMENT.txt" "MODE_II_H0_ENDPOINT_CORRECTED_DATACHECK_STATUS.json" \
    "MODE_II_H0_ENDPOINT_CORRECTED_DATACHECK.ok" \
    "input_hash_check.txt" "executables.txt"; do
    if [ -f "${SCRATCH_RUN}/${pattern}" ]; then
      cp "${SCRATCH_RUN}/${pattern}" "${EVIDENCE_DIR}/" 2>/dev/null || true
    fi
  done
}

PRE_SOLVER_ONLY="${MODE_II_H0_PRE_SOLVER_ONLY:-0}"
ALLOW_LOCAL_NO_MODULES="${MODE_II_H0_ALLOW_LOCAL_NO_MODULES:-0}"
MODULE_ENVIRONMENT_LOADED=false

if command -v module >/dev/null 2>&1; then
  module --force purge > "${ENV_LOG}" 2>&1 || true

  module load gcc/11.4.0 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_env_fail" 5 "module load gcc/11.4.0 failed"
    copy_evidence
    exit 5
  }
  module load intel/2024.2.0 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_env_fail" 5 "module load intel/2024.2.0 failed"
    copy_evidence
    exit 5
  }
  module load abaqus/2023 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_env_fail" 5 "module load abaqus/2023 failed"
    copy_evidence
    exit 5
  }
  module load python/gcc/11.4.0/3.11.7 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_env_fail" 5 "module load python/gcc/11.4.0/3.11.7 failed"
    copy_evidence
    exit 5
  }
  MODULE_ENVIRONMENT_LOADED=true
elif [ "${PRE_SOLVER_ONLY}" = "1" ] && [ "${ALLOW_LOCAL_NO_MODULES}" = "1" ]; then
  echo "Local check: module environment bypassed" >> "${ENV_LOG}"
  MODULE_ENVIRONMENT_LOADED=false
else
  write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_env_fail" 5 "required module command unavailable"
  copy_evidence
  exit 5
fi

if [ -z "${PRESTAGED_ROOT:-}" ] || [ -z "${LOGIN_MANIFEST_PATH}" ] || [ ! -f "${LOGIN_MANIFEST_PATH}" ]; then
  write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_stage_fail" 3 "missing PRESTAGED_ROOT or LOGIN_MANIFEST_PATH"
  copy_evidence
  exit 3
fi

cd "${PRESTAGED_ROOT}/${PACKAGE_REL}" || {
  write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_stage_fail" 4 "missing staged package"
  copy_evidence
  exit 4
}
sha256sum -c input_hashes.sha256 > "${SCRATCH_RUN}/input_hash_check.txt" 2>&1 || {
  write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_hash_fail" 6 "staged input hash failure"
  copy_evidence
  exit 6
}

cp ModeII_H0_endpoint_corrected_serial.inp "${SCRATCH_RUN}/${JOB_NAME}.inp"
cp ModeII_H0_endpoint_corrected_serial.for "${SCRATCH_RUN}/ModeII_H0_endpoint_corrected_serial.for"

cd "${SCRATCH_RUN}" || exit 7

if [ "${PRE_SOLVER_ONLY}" = "1" ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H0_ENDPOINT_CORRECTED_DATACHECK_STATUS.json" <<EOF
{
  "classification": "stage_f_mode_ii_h0_endpoint_corrected_datacheck_preflight_pass",
  "preflight_ok": true,
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  copy_evidence
  exit 0
fi

set +e
abaqus job="${JOB_NAME}" user=ModeII_H0_endpoint_corrected_serial.for datacheck interactive \
  cpus=1 mp_mode=threads double=both \
  > "${JOB_NAME}.abaqus_stdout.log" 2>&1
ABAQUS_RC=$?
set -e

if [ "${ABAQUS_RC}" -eq 0 ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H0_ENDPOINT_CORRECTED_DATACHECK_STATUS.json" <<EOF
{
  "DATACHECK_ok": true,
  "classification": "stage_f_mode_ii_h0_endpoint_corrected_datacheck_pass",
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "abaqus_return_code": 0,
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  : > "${SCRATCH_RUN}/MODE_II_H0_ENDPOINT_CORRECTED_DATACHECK.ok"
  copy_evidence
  exit 0
fi

write_status "stage_f_mode_ii_h0_endpoint_corrected_datacheck_fail" "${ABAQUS_RC}" "abaqus datacheck failed"
copy_evidence
exit 10
