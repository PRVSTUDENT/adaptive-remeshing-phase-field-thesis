#!/bin/bash
#PBS -N M2H2U20R1
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=12:00:00
#PBS -q entry_imfdfkmq
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR}" || exit 21

JOBNAME="M2H2U20R1"
INP_FILE="ModeII_H2_uniform_serial.inp"
USER_SUB="ModeII_H2_uniform_serial.for"
MANIFEST="RUNTIME_MANIFEST.json"
SUMS="SHA256SUMS"
ABAQUS_RC=999
EXT_RC=999
VAL_RC=999

write_status() {
    local final_rc="$1"
    local status="$2"
    cat > STATUS.json <<EOF
{
  "job_name": "${JOBNAME}",
  "pbs_job_id": "${PBS_JOBID:-unknown}",
  "source_git_revision": "${SOURCE_GIT_REVISION:-unknown}",
  "ABAQUS_RC": ${ABAQUS_RC},
  "EXT_RC": ${EXT_RC},
  "VAL_RC": ${VAL_RC},
  "final_exit_code": ${final_rc},
  "final_technical_status": "${status}"
}
EOF
}

for required in "${INP_FILE}" "${USER_SUB}" "${MANIFEST}" "${SUMS}" \
    "runtime/scripts/postprocessing/extract_mode_ii_uniform_reference.py" \
    "runtime/scripts/validation/validate_mode_ii_h2_results.py"; do
    if [ ! -f "${required}" ]; then
        echo "ERROR: required staged file missing: ${required}"
        write_status 21 "required_staged_file_missing"
        exit 21
    fi
done

SOURCE_GIT_REVISION=$(python3 -c 'import json; print(json.load(open("RUNTIME_MANIFEST.json"))["source_git_revision"])' 2>/dev/null || echo unknown)
if [ "${SOURCE_GIT_REVISION}" = "unknown" ]; then
    echo "ERROR: runtime manifest is unreadable"
    write_status 20 "runtime_manifest_unreadable"
    exit 20
fi

if ! sha256sum -c "${SUMS}"; then
    echo "ERROR: staged runtime hash verification failed"
    write_status 20 "runtime_hash_verification_failed"
    exit 20
fi

module load abaqus
abaqus job="${JOBNAME}" input="${INP_FILE}" user="${USER_SUB}" interactive > "${JOBNAME}.abaqus_stdout.log" 2>&1
ABAQUS_RC=$?

if [ "${ABAQUS_RC}" -eq 0 ]; then
    mkdir -p extracted
    abaqus python "runtime/scripts/postprocessing/extract_mode_ii_uniform_reference.py" \
        --odb "${JOBNAME}.odb" \
        --output-dir extracted \
        --sta "${JOBNAME}.sta" \
        --log "${JOBNAME}.abaqus_stdout.log" \
        --target-u1 0.020 > extracted/extractor_stdout.log 2>&1
    EXT_RC=$?
fi

if [ "${EXT_RC}" -eq 0 ]; then
    python3 "runtime/scripts/validation/validate_mode_ii_h2_results.py" \
        --evidence-dir extracted \
        --abaqus-return-code "${ABAQUS_RC}" \
        --extractor-return-code "${EXT_RC}" \
        --expected-u1-target 0.020 > extracted/validator_stdout.log 2>&1
    VAL_RC=$?
fi

if [ "${ABAQUS_RC}" -ne 0 ]; then
    write_status 10 "abaqus_failed"
    exit 10
elif [ "${EXT_RC}" -ne 0 ]; then
    write_status 11 "extraction_failed"
    exit 11
elif [ "${VAL_RC}" -ne 0 ]; then
    write_status 12 "validation_failed"
    exit 12
fi

write_status 0 "technical_pass"
exit 0
