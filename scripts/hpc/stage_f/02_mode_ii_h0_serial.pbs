#!/bin/bash
#PBS -N mode_ii_h0_serial
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -m abe

# Stage F1-J1: Mode-II H0 serial scientific baseline solver execution.
# One-shot serial CPU1/16GB/04:00 execution; no automatic retry.

set -uo pipefail

EVIDENCE_ROOT="${EVIDENCE_ROOT:-/home/pr21vyci/adaptive-remeshing-evidence}"
EVIDENCE_DIR="${EVIDENCE_ROOT}/stage_f/mode_ii_h0/${PBS_JOBID:-manual}"
PACKAGE_REL="models/generated/mode_ii/h0_serial"
SCRATCH_RUN="${SCRATCH_RUN:-/scratch/pr21vyci/adaptive-remeshing/runs/mode_ii_h0_serial_${PBS_JOBID:-manual}}"
ENV_LOG="${SCRATCH_RUN}/COMPILER_ENVIRONMENT.txt"
JOB_NAME="mode_ii_h0_serial"
SOURCE_COMMIT="${PROJECT_REVISION:-unknown}"
LOGIN_MANIFEST_PATH="${LOGIN_MANIFEST_PATH:-}"

mkdir -p "${EVIDENCE_DIR}" "${SCRATCH_RUN}"
cd "${SCRATCH_RUN}" || exit 2

write_status() {
  local classification="$1"
  local abaqus_rc="$2"
  local ext_rc="$3"
  local val_rc="$4"
  local failure="$5"
  cat > "${SCRATCH_RUN}/MODE_II_H0_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H0_SERIAL_ok": false,
  "classification": "${classification}",
  "failures": ["${failure}"],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "abaqus_return_code": ${abaqus_rc},
  "extractor_return_code": ${ext_rc},
  "validator_return_code": ${val_rc},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
}

copy_evidence() {
  mkdir -p "${EVIDENCE_DIR}"
  for pattern in \
    "${JOB_NAME}.log" "${JOB_NAME}.msg" "${JOB_NAME}.dat" "${JOB_NAME}.sta" \
    "${JOB_NAME}.com" "${JOB_NAME}.prt" "${JOB_NAME}.abaqus_stdout.log" \
    "COMPILER_ENVIRONMENT.txt" "MODE_II_H0_SERIAL_STATUS.json" \
    "MODE_II_H0_SERIAL_VALIDATION.json" "MODE_II_H0_RUNTIME_MANIFEST.json" \
    "MODE_II_H0_RUNTIME_STAGING_CHECK.json" \
    "MODE_II_H0_SERIAL.ok" "MODE_II_H0_PRE_SOLVER_SMOKE.ok" \
    "input_hash_check.txt" "executables.txt"; do
    if [ -f "${SCRATCH_RUN}/${pattern}" ]; then
      cp "${SCRATCH_RUN}/${pattern}" "${EVIDENCE_DIR}/" 2>/dev/null || true
    fi
  done
  if [ -d "${SCRATCH_RUN}/extracted" ]; then
    cp -a "${SCRATCH_RUN}/extracted" "${EVIDENCE_DIR}/" 2>/dev/null || true
  fi
}

PRE_SOLVER_ONLY="${MODE_II_H0_PRE_SOLVER_ONLY:-0}"
ALLOW_LOCAL_NO_MODULES="${MODE_II_H0_ALLOW_LOCAL_NO_MODULES:-0}"
MODULE_ENVIRONMENT_LOADED=false

if command -v module >/dev/null 2>&1; then
  module --force purge > "${ENV_LOG}" 2>&1 || true

  module load gcc/11.4.0 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "module load gcc/11.4.0 failed"
    copy_evidence
    exit 5
  }
  module load intel/2024.2.0 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "module load intel/2024.2.0 failed"
    copy_evidence
    exit 5
  }
  module load abaqus/2023 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "module load abaqus/2023 failed"
    copy_evidence
    exit 5
  }
  module load python/gcc/11.4.0/3.11.7 >> "${ENV_LOG}" 2>&1 || {
    write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "module load python/gcc/11.4.0/3.11.7 failed"
    copy_evidence
    exit 5
  }

  MODULE_ENVIRONMENT_LOADED=true
elif [ "${PRE_SOLVER_ONLY}" = "1" ] && [ "${ALLOW_LOCAL_NO_MODULES}" = "1" ]; then
  echo "Local smoke only: module environment explicitly bypassed" >> "${ENV_LOG}"
  MODULE_ENVIRONMENT_LOADED=false
else
  write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "required module command unavailable"
  copy_evidence
  exit 5
fi

python3 -c 'import sys; assert sys.version_info >= (3, 10), sys.version' >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "python 3.10+ check failed"
  copy_evidence
  exit 5
}

if [ "${MODULE_ENVIRONMENT_LOADED}" = "true" ]; then
  command -v python3 >/dev/null 2>&1 || {
    write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "command -v python3 failed"
    copy_evidence
    exit 5
  }
  command -v abaqus >/dev/null 2>&1 || {
    write_status "stage_f_mode_ii_h0_serial_env_fail" 5 -1 -1 "command -v abaqus failed"
    copy_evidence
    exit 5
  }
fi

{
  command -v abaqus || true
  command -v ifort || true
  command -v ifx || true
  command -v python3 || true
  python3 --version || true
} > "${SCRATCH_RUN}/executables.txt"

if [ -z "${PRESTAGED_ROOT:-}" ] || [ -z "${PRESTAGED_RUNTIME_ROOT:-}" ] || [ -z "${LOGIN_MANIFEST_PATH}" ] || [ ! -f "${LOGIN_MANIFEST_PATH}" ]; then
  write_status "stage_f_mode_ii_h0_serial_stage_fail" 3 -1 -1 "missing PRESTAGED_ROOT, PRESTAGED_RUNTIME_ROOT, or LOGIN_MANIFEST_PATH"
  copy_evidence
  exit 3
fi

cd "${PRESTAGED_ROOT}/${PACKAGE_REL}" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" 4 -1 -1 "missing staged package"
  copy_evidence
  exit 4
}
sha256sum -c input_hashes.sha256 > "${SCRATCH_RUN}/input_hash_check.txt" 2>&1 || {
  write_status "stage_f_mode_ii_h0_serial_hash_fail" 6 -1 -1 "staged input hash failure"
  copy_evidence
  exit 6
}

ORIGINAL_DECK="${SCRATCH_RUN}/ModeII_H0_serial.inp"
ABAQUS_DECK="${SCRATCH_RUN}/${JOB_NAME}.inp"
SOURCE_FILE="${SCRATCH_RUN}/ModeII_H0_serial.for"

cp ModeII_H0_serial.inp "${ORIGINAL_DECK}"
cp "${ORIGINAL_DECK}" "${ABAQUS_DECK}"
cp ModeII_H0_serial.for "${SOURCE_FILE}"

cd "${SCRATCH_RUN}" || exit 7

EXTRACTOR_SCRIPT="${PRESTAGED_RUNTIME_ROOT}/scripts/postprocessing/extract_molnar_single_notch.py"
VALIDATOR_SCRIPT="${PRESTAGED_RUNTIME_ROOT}/scripts/validation/validate_mode_ii_h0_serial_results.py"
STAGED_PBS_SCRIPT="${PRESTAGED_RUNTIME_ROOT}/scripts/hpc/stage_f/02_mode_ii_h0_serial.pbs"
STAGING_CHECKER="${PRESTAGED_RUNTIME_ROOT}/scripts/validation/verify_mode_ii_h0_runtime_staging.py"

DECK_SHA="$(sha256sum "${ORIGINAL_DECK}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash staged original deck"
  copy_evidence
  exit 7
}

ABAQUS_DECK_SHA="$(sha256sum "${ABAQUS_DECK}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash Abaqus job deck"
  copy_evidence
  exit 7
}

SOURCE_SHA="$(sha256sum "${SOURCE_FILE}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash staged Fortran source"
  copy_evidence
  exit 7
}

test "${DECK_SHA}" = "${ABAQUS_DECK_SHA}" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "original and Abaqus deck hashes differ"
  copy_evidence
  exit 7
}

EXTRACTOR_SHA="$(sha256sum "${EXTRACTOR_SCRIPT}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash extractor script"
  copy_evidence
  exit 7
}

VALIDATOR_SHA="$(sha256sum "${VALIDATOR_SCRIPT}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash validator script"
  copy_evidence
  exit 7
}

STAGING_CHECKER_SHA="$(sha256sum "${STAGING_CHECKER}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash staging checker script"
  copy_evidence
  exit 7
}

PBS_SHA="$(sha256sum "${STAGED_PBS_SCRIPT}" | awk '{print $1}')" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "could not hash PBS script"
  copy_evidence
  exit 7
}

is_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

for value in \
  "${DECK_SHA}" \
  "${ABAQUS_DECK_SHA}" \
  "${SOURCE_SHA}" \
  "${EXTRACTOR_SHA}" \
  "${VALIDATOR_SHA}" \
  "${STAGING_CHECKER_SHA}" \
  "${PBS_SHA}"; do
  is_sha256 "${value}" || {
    write_status "stage_f_mode_ii_h0_serial_stage_fail" -1 -1 -1 "empty or invalid runtime hash"
    copy_evidence
    exit 7
  }
done

RUNTIME_MANIFEST="${SCRATCH_RUN}/MODE_II_H0_RUNTIME_MANIFEST.json"
cat > "${RUNTIME_MANIFEST}" <<EOF
{
  "project_revision": "${SOURCE_COMMIT}",
  "job_name": "mode_ii_h0_serial",
  "cpus": 1,
  "mpi_ranks": 1,
  "omp_threads": 1,
  "mp_mode": "threads",
  "memory": "16 GB",
  "walltime": "04:00:00",
  "deck_sha256": "${DECK_SHA}",
  "abaqus_deck_sha256": "${ABAQUS_DECK_SHA}",
  "source_sha256": "${SOURCE_SHA}",
  "extractor_sha256": "${EXTRACTOR_SHA}",
  "validator_sha256": "${VALIDATOR_SHA}",
  "staging_checker_sha256": "${STAGING_CHECKER_SHA}",
  "pbs_script_sha256": "${PBS_SHA}"
}
EOF

STAGING_CHECK="${SCRATCH_RUN}/MODE_II_H0_RUNTIME_STAGING_CHECK.json"
python3 "${STAGING_CHECKER}" \
  --login-manifest "${LOGIN_MANIFEST_PATH}" \
  --runtime-manifest "${RUNTIME_MANIFEST}" \
  --output "${STAGING_CHECK}"
STAGING_CHECK_RC=$?

if [ "${STAGING_CHECK_RC}" -ne 0 ] || [ ! -f "${STAGING_CHECK}" ]; then
  write_status "stage_f_mode_ii_h0_serial_staging_fail" -1 -1 -1 "runtime staging check mismatch"
  copy_evidence
  exit 7
fi
if ! grep -q '"classification": "stage_f_mode_ii_h0_runtime_staging_pass"' "${STAGING_CHECK}" || \
   ! grep -q '"failures": \[\]' "${STAGING_CHECK}"; then
  write_status "stage_f_mode_ii_h0_serial_staging_fail" -1 -1 -1 "runtime staging check classification mismatch"
  copy_evidence
  exit 7
fi

if [ "${MODE_II_H0_PRE_SOLVER_ONLY:-0}" = "1" ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H0_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H0_SERIAL_ok": true,
  "classification": "stage_f_mode_ii_h0_pre_solver_smoke_pass",
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "pre_solver_only": true,
  "module_environment_loaded": ${MODULE_ENVIRONMENT_LOADED},
  "abaqus_invoked": false,
  "extractor_invoked": false,
  "validator_invoked": false,
  "abaqus_return_code": null,
  "extractor_return_code": null,
  "validator_return_code": null,
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  : > "${SCRATCH_RUN}/MODE_II_H0_PRE_SOLVER_SMOKE.ok"
  copy_evidence
  exit 0
fi


export OMP_NUM_THREADS=1
export ABAQUS_PASSWD=""

# Serial full analysis run
set +e
abaqus job="${JOB_NAME}" user=ModeII_H0_serial.for interactive \
  cpus=1 mp_mode=threads double=both \
  > "${JOB_NAME}.abaqus_stdout.log" 2>&1
ABAQUS_RC=$?
set -e

MSG_FILE="${JOB_NAME}.msg"
DAT_FILE="${JOB_NAME}.dat"
STA_FILE="${JOB_NAME}.sta"
ODB_FILE="${JOB_NAME}.odb"

pass=true
failure="none"
EXT_RC=0
VAL_RC=0

if [ "${ABAQUS_RC}" -ne 0 ]; then
  pass=false
  failure="abaqus_solver_nonzero_exit"
fi

if [ "${pass}" = true ]; then
  # Run extraction using prestaged runtime script
  mkdir -p "${SCRATCH_RUN}/extracted"
  set +e
  abaqus python "${EXTRACTOR_SCRIPT}" \
    --odb "${SCRATCH_RUN}/${ODB_FILE}" \
    --sta "${SCRATCH_RUN}/${STA_FILE}" \
    --dat "${SCRATCH_RUN}/${DAT_FILE}" \
    --msg "${SCRATCH_RUN}/${MSG_FILE}" \
    --displacement-component 1 \
    --reaction-component 1 \
    --path-threshold 0.5 \
    --output-dir "${SCRATCH_RUN}/extracted" \
    >> "${JOB_NAME}.abaqus_stdout.log" 2>&1
  EXT_RC=$?
  set -e
  if [ "${EXT_RC}" -ne 0 ]; then
    pass=false
    failure="extraction_failed"
  fi
fi

if [ "${pass}" = true ]; then
  # Run result validation using prestaged runtime script
  set +e
  python3 "${VALIDATOR_SCRIPT}" \
    --extraction-dir "${SCRATCH_RUN}/extracted" \
    --sta "${SCRATCH_RUN}/${STA_FILE}" \
    --dat "${SCRATCH_RUN}/${DAT_FILE}" \
    --msg "${SCRATCH_RUN}/${MSG_FILE}" \
    --runtime-manifest "${RUNTIME_MANIFEST}" \
    --login-manifest "${LOGIN_MANIFEST_PATH}" \
    --runtime-staging-check "${STAGING_CHECK}" \
    --input-hash-check "${SCRATCH_RUN}/input_hash_check.txt" \
    --output-json "${SCRATCH_RUN}/MODE_II_H0_SERIAL_VALIDATION.json" \
    --expected-final-displacement 0.010 \
    --final-displacement-tolerance 1e-6 \
    >> "${JOB_NAME}.abaqus_stdout.log" 2>&1
  VAL_RC=$?
  set -e
  if [ "${VAL_RC}" -ne 0 ]; then
    pass=false
    failure="result_validation_failed"
  fi
fi

if [ "${pass}" = true ] && [ -f "${SCRATCH_RUN}/MODE_II_H0_SERIAL_VALIDATION.json" ]; then
  if grep -q '"classification": "stage_f_mode_ii_h0_serial_baseline_characterized"' "${SCRATCH_RUN}/MODE_II_H0_SERIAL_VALIDATION.json" && \
     grep -q '"failures": \[\]' "${SCRATCH_RUN}/MODE_II_H0_SERIAL_VALIDATION.json"; then
    cat > "${SCRATCH_RUN}/MODE_II_H0_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H0_SERIAL_ok": true,
  "classification": "stage_f_mode_ii_h0_serial_baseline_characterized",
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "abaqus_return_code": ${ABAQUS_RC},
  "extractor_return_code": ${EXT_RC},
  "validator_return_code": ${VAL_RC},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
    : > "${SCRATCH_RUN}/MODE_II_H0_SERIAL.ok"
    copy_evidence
    exit 0
  fi
  failure="validation_report_classification_mismatch"
fi

write_status "stage_f_mode_ii_h0_serial_fail" "${ABAQUS_RC}" "${EXT_RC}" "${VAL_RC}" "${failure}"
copy_evidence
exit 12
