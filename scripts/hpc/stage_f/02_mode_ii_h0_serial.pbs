#!/bin/bash
#PBS -N mode_ii_h0_serial
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -m abe

# Stage F1-J1: Mode-II H0 serial scientific baseline solver execution.
# One-shot serial CPU1/16GB/04:00 execution; no automatic retry.

set -uo pipefail

PROJECT_HOME="${PROJECT_HOME:-/home/pr21vyci/projects/adaptive-remeshing}"
PACKAGE_REL="models/generated/mode_ii/h0_serial"
EVIDENCE_DIR="${PROJECT_HOME}/runs/hpc/stage_f/mode_ii_h0/evidence/${PBS_JOBID:-manual}"
SCRATCH_RUN="/scratch/pr21vyci/adaptive-remeshing/runs/mode_ii_h0_serial_${PBS_JOBID:-manual}"
ENV_LOG="${SCRATCH_RUN}/COMPILER_ENVIRONMENT.txt"
JOB_NAME="mode_ii_h0_serial"
SOURCE_COMMIT="${PROJECT_REVISION:-unknown}"

mkdir -p "${EVIDENCE_DIR}" "${SCRATCH_RUN}"
cd "${SCRATCH_RUN}" || exit 2

write_status() {
  local classification="$1"
  local abaqus_rc="$2"
  local failure="$3"
  cat > "${SCRATCH_RUN}/MODE_II_H0_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H0_SERIAL_ok": false,
  "classification": "${classification}",
  "failures": ["${failure}"],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "pbs_exit_status": ${abaqus_rc},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
}

copy_evidence() {
  mkdir -p "${EVIDENCE_DIR}"
  for pattern in \
    "${JOB_NAME}.log" "${JOB_NAME}.msg" "${JOB_NAME}.dat" "${JOB_NAME}.sta" \
    "${JOB_NAME}.com" "${JOB_NAME}.prt" "${JOB_NAME}.abaqus_stdout.log" \
    "COMPILER_ENVIRONMENT.txt" "MODE_II_H0_SERIAL_STATUS.json" \
    "MODE_II_H0_SERIAL.ok" "input_hash_check.txt" "executables.txt"; do
    if [ -f "${SCRATCH_RUN}/${pattern}" ]; then
      cp "${SCRATCH_RUN}/${pattern}" "${EVIDENCE_DIR}/" 2>/dev/null || true
    fi
  done
  if [ -d "${SCRATCH_RUN}/extracted" ]; then
    cp -a "${SCRATCH_RUN}/extracted" "${EVIDENCE_DIR}/" 2>/dev/null || true
  fi
}

module --force purge > "${ENV_LOG}" 2>&1 || true
module load gcc/11.4.0 >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_serial_env_fail" 5 "module load gcc/11.4.0 failed"
  copy_evidence
  exit 5
}
module load intel/2024.2.0 >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_serial_env_fail" 5 "module load intel/2024.2.0 failed"
  copy_evidence
  exit 5
}
module load abaqus/2023 >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_serial_env_fail" 5 "module load abaqus/2023 failed"
  copy_evidence
  exit 5
}
module load python/gcc/11.4.0/3.11.7 >> "${ENV_LOG}" 2>&1 || true

{
  command -v abaqus || true
  command -v ifort || true
  command -v ifx || true
} > "${SCRATCH_RUN}/executables.txt"

if [ -z "${PRESTAGED_ROOT:-}" ]; then
  write_status "stage_f_mode_ii_h0_serial_stage_fail" 3 "missing PRESTAGED_ROOT"
  copy_evidence
  exit 3
fi

cd "${PRESTAGED_ROOT}/${PACKAGE_REL}" || {
  write_status "stage_f_mode_ii_h0_serial_stage_fail" 4 "missing staged package"
  copy_evidence
  exit 4
}
sha256sum -c input_hashes.sha256 > "${SCRATCH_RUN}/input_hash_check.txt" 2>&1 || {
  write_status "stage_f_mode_ii_h0_serial_hash_fail" 6 "staged input hash failure"
  copy_evidence
  exit 6
}

cp ModeII_H0_serial.inp "${SCRATCH_RUN}/${JOB_NAME}.inp"
cp ModeII_H0_serial.for "${SCRATCH_RUN}/ModeII_H0_serial.for"
cd "${SCRATCH_RUN}" || exit 7

export OMP_NUM_THREADS=1
export ABAQUS_PASSWD=""

# Serial full analysis run
set +e
abaqus job="${JOB_NAME}" user=ModeII_H0_serial.for interactive \
  cpus=1 mp_mode=threads double=both \
  > "${JOB_NAME}.abaqus_stdout.log" 2>&1
ABAQUS_RC=$?
set -e

MSG_FILE="${JOB_NAME}.msg"
DAT_FILE="${JOB_NAME}.dat"
STA_FILE="${JOB_NAME}.sta"
ODB_FILE="${JOB_NAME}.odb"

pass=true
failure="none"
if [ "${ABAQUS_RC}" -ne 0 ]; then
  pass=false
  failure="abaqus_solver_nonzero_exit"
fi

if [ "${pass}" = true ]; then
  # Run extraction
  mkdir -p "${SCRATCH_RUN}/extracted"
  set +e
  abaqus python "${PROJECT_HOME}/scripts/postprocessing/extract_molnar_single_notch.py" \
    --odb "${SCRATCH_RUN}/${ODB_FILE}" \
    --sta "${SCRATCH_RUN}/${STA_FILE}" \
    --dat "${SCRATCH_RUN}/${DAT_FILE}" \
    --msg "${SCRATCH_RUN}/${MSG_FILE}" \
    --displacement-component 1 \
    --reaction-component 1 \
    --path-threshold 0.5 \
    --output-dir "${SCRATCH_RUN}/extracted" \
    >> "${JOB_NAME}.abaqus_stdout.log" 2>&1
  EXT_RC=$?
  set -e
  if [ "${EXT_RC}" -ne 0 ]; then
    pass=false
    failure="extraction_failed"
  fi
fi

if [ "${pass}" = true ]; then
  # Run result validation
  set +e
  python3 "${PROJECT_HOME}/scripts/validation/validate_mode_ii_h0_serial_results.py" \
    --extraction-dir "${SCRATCH_RUN}/extracted" \
    --sta "${SCRATCH_RUN}/${STA_FILE}" \
    --dat "${SCRATCH_RUN}/${DAT_FILE}" \
    --msg "${SCRATCH_RUN}/${MSG_FILE}" \
    >> "${JOB_NAME}.abaqus_stdout.log" 2>&1
  VAL_RC=$?
  set -e
  if [ "${VAL_RC}" -ne 0 ]; then
    pass=false
    failure="result_validation_failed"
  fi
fi

if [ "${pass}" = true ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H0_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H0_SERIAL_ok": true,
  "classification": "stage_f_mode_ii_h0_serial_baseline_characterized",
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "pbs_exit_status": ${ABAQUS_RC},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  : > "${SCRATCH_RUN}/MODE_II_H0_SERIAL.ok"
  copy_evidence
  exit 0
fi

write_status "stage_f_mode_ii_h0_serial_fail" "${ABAQUS_RC}" "${failure}"
copy_evidence
exit 12
