#!/bin/bash
#PBS -N M2H2CMP1
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m abe

set -uo pipefail
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

JOB_NAME="M2H2CMP1"
ROOT="${PROJECT_ROOT:-/home/pr21vyci/projects/adaptive-remeshing}"
PACKAGE="${ROOT}/models/generated/mode_ii/h2_u020_compiler_datacheck_smoke"
SOURCE="${ROOT}/models/generated/mode_ii/h2_uniform_serial_u020_postpeak"
RUN="${SCRATCH_RUN:-/scratch/pr21vyci/adaptive-remeshing/runs/${JOB_NAME}_${PBS_JOBID:-manual}}"
STATUS="${RUN}/STATUS.json"
COMPILER_STATUS="${RUN}/COMPILER_STATUS.json"
ENV_LOG="${RUN}/COMPILER_ENVIRONMENT.txt"
mkdir -p "${RUN}"

write_status() {
  classification="$1"
  rc="$2"
  cat > "${STATUS}" <<EOF
{"classification":"${classification}","return_code":${rc},"job_name":"${JOB_NAME}","full_analysis_launched":false}
EOF
}

module --force purge > "${ENV_LOG}" 2>&1 || true
module load gcc/11.4.0 >> "${ENV_LOG}" 2>&1 || { write_status compiler_environment_missing 5; exit 5; }
module load intel/2024.2.0 >> "${ENV_LOG}" 2>&1 || { write_status compiler_environment_missing 5; exit 5; }
module load abaqus/2023 >> "${ENV_LOG}" 2>&1 || { write_status compiler_environment_missing 5; exit 5; }
module list >> "${ENV_LOG}" 2>&1 || true

IFORT_PATH="$(command -v ifort || true)"
IFX_PATH="$(command -v ifx || true)"
ABAQUS_PATH="$(command -v abaqus || true)"
{
  echo "ifort=${IFORT_PATH}"
  echo "ifx=${IFX_PATH}"
  echo "abaqus=${ABAQUS_PATH}"
  ifort --version 2>&1 || true
  ifx --version 2>&1 || true
  abaqus information=release 2>&1 || true
  abaqus information=system 2>&1 || true
} >> "${ENV_LOG}"

if [ -z "${ABAQUS_PATH}" ] || { [ -z "${IFORT_PATH}" ] && [ -z "${IFX_PATH}" ]; }; then
  cat > "${COMPILER_STATUS}" <<EOF
{"classification":"compiler_environment_missing","compiler_detected":false,"ifort_path":"${IFORT_PATH}","ifx_path":"${IFX_PATH}","abaqus_path":"${ABAQUS_PATH}"}
EOF
  write_status compiler_environment_missing 5
  exit 5
fi

cat > "${COMPILER_STATUS}" <<EOF
{"classification":"compiler_detected","compiler_detected":true,"ifort_path":"${IFORT_PATH}","ifx_path":"${IFX_PATH}","abaqus_path":"${ABAQUS_PATH}"}
EOF

cd "${PACKAGE}" || { write_status datacheck_failed 4; exit 4; }
sha256sum -c input_hashes.sha256 > "${RUN}/input_hash_check.txt" 2>&1 || { write_status datacheck_failed 6; exit 6; }
cp "${SOURCE}/ModeII_H2_uniform_serial.inp" "${RUN}/${JOB_NAME}.inp"
cp "${SOURCE}/ModeII_H2_uniform_serial.for" "${RUN}/ModeII_H2_uniform_serial.for"
cd "${RUN}" || exit 7

set +e
abaqus job="${JOB_NAME}" user=ModeII_H2_uniform_serial.for datacheck interactive \
  cpus=1 mp_mode=threads double=both > "${RUN}/abaqus_stdout.log" 2>&1
ABAQUS_RC=$?
set -e

if [ "${ABAQUS_RC}" -ne 0 ]; then
  if grep -Eqi "compile|compiler|fortcom|ifort|ifx" "${RUN}/abaqus_stdout.log" "${RUN}/${JOB_NAME}.log" 2>/dev/null; then
    write_status compilation_failed "${ABAQUS_RC}"
  elif grep -Eqi "link|ld:|undefined reference" "${RUN}/abaqus_stdout.log" "${RUN}/${JOB_NAME}.log" 2>/dev/null; then
    write_status link_failed "${ABAQUS_RC}"
  else
    write_status datacheck_failed "${ABAQUS_RC}"
  fi
  exit "${ABAQUS_RC}"
fi

write_status datacheck_pass 0
exit 0
