#!/bin/bash
#PBS -N mode_ii_h0_dc
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m abe

# Stage F1-J0: Mode-II H0 compile/link/datacheck only.
# Full solver analysis must not start. One-shot; no automatic retry.

set -uo pipefail

PROJECT_HOME="${PROJECT_HOME:-/home/pr21vyci/projects/adaptive-remeshing}"
PACKAGE_REL="models/generated/mode_ii/h0_serial"
EVIDENCE_DIR="${PROJECT_HOME}/runs/hpc/stage_f/mode_ii_h0/evidence/${PBS_JOBID:-manual}"
SCRATCH_RUN="/scratch/pr21vyci/adaptive-remeshing/runs/mode_ii_h0_dc_${PBS_JOBID:-manual}"
ENV_LOG="${SCRATCH_RUN}/COMPILER_ENVIRONMENT.txt"
JOB_NAME="mode_ii_h0_dc"
SOURCE_COMMIT="${PROJECT_REVISION:-unknown}"

mkdir -p "${EVIDENCE_DIR}" "${SCRATCH_RUN}"
cd "${SCRATCH_RUN}" || exit 2

write_status() {
  local classification="$1"
  local abaqus_rc="$2"
  local failure="$3"
  cat > "${SCRATCH_RUN}/MODE_II_H0_DATACHECK_STATUS.json" <<EOF
{
  "MODE_II_H0_DATACHECK_ok": false,
  "classification": "${classification}",
  "failures": ["${failure}"],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "pbs_exit_status": ${abaqus_rc},
  "solver_analysis_started": false,
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
}

copy_evidence() {
  mkdir -p "${EVIDENCE_DIR}"
  for pattern in \
    "${JOB_NAME}.log" "${JOB_NAME}.msg" "${JOB_NAME}.dat" "${JOB_NAME}.sta" \
    "${JOB_NAME}.com" "${JOB_NAME}.prt" "${JOB_NAME}.abaqus_stdout.log" \
    "COMPILER_ENVIRONMENT.txt" "MODE_II_H0_DATACHECK_STATUS.json" \
    "MODE_II_H0_DATACHECK.ok" "input_hash_check.txt" "executables.txt"; do
    if [ -f "${SCRATCH_RUN}/${pattern}" ]; then
      cp "${SCRATCH_RUN}/${pattern}" "${EVIDENCE_DIR}/" 2>/dev/null || true
    fi
  done
}

module --force purge > "${ENV_LOG}" 2>&1 || true
module load gcc/11.4.0 >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_datacheck_env_fail" 5 "module load gcc/11.4.0 failed"
  copy_evidence
  exit 5
}
module load intel/2024.2.0 >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_datacheck_env_fail" 5 "module load intel/2024.2.0 failed"
  copy_evidence
  exit 5
}
module load abaqus/2023 >> "${ENV_LOG}" 2>&1 || {
  write_status "stage_f_mode_ii_h0_datacheck_env_fail" 5 "module load abaqus/2023 failed"
  copy_evidence
  exit 5
}
{
  command -v abaqus || true
  command -v ifort || true
  command -v ifx || true
} > "${SCRATCH_RUN}/executables.txt"

if [ -z "${PRESTAGED_ROOT:-}" ]; then
  write_status "stage_f_mode_ii_h0_datacheck_stage_fail" 3 "missing PRESTAGED_ROOT"
  copy_evidence
  exit 3
fi

cd "${PRESTAGED_ROOT}/${PACKAGE_REL}" || {
  write_status "stage_f_mode_ii_h0_datacheck_stage_fail" 4 "missing staged package"
  copy_evidence
  exit 4
}
sha256sum -c input_hashes.sha256 > "${SCRATCH_RUN}/input_hash_check.txt" 2>&1 || {
  write_status "stage_f_mode_ii_h0_datacheck_hash_fail" 6 "staged input hash failure"
  copy_evidence
  exit 6
}

cp ModeII_H0_serial.inp "${SCRATCH_RUN}/${JOB_NAME}.inp"
cp ModeII_H0_serial.for "${SCRATCH_RUN}/ModeII_H0_serial.for"
cd "${SCRATCH_RUN}" || exit 7

export OMP_NUM_THREADS=1
export ABAQUS_PASSWD=""

# Datacheck only: do not run a full analysis.
set +e
abaqus job="${JOB_NAME}" user=ModeII_H0_serial.for datacheck interactive \
  cpus=1 mp_mode=threads double=both \
  > "${JOB_NAME}.abaqus_stdout.log" 2>&1
ABAQUS_RC=$?
set -e

MSG_FILE="${JOB_NAME}.msg"
DAT_FILE="${JOB_NAME}.dat"
STA_FILE="${JOB_NAME}.sta"
STDOUT_FILE="${JOB_NAME}.abaqus_stdout.log"

pass=true
failure="none"
if [ "${ABAQUS_RC}" -ne 0 ]; then
  pass=false
  failure="abaqus_datacheck_nonzero_exit"
fi
if ! grep -Eqi "THE ANALYSIS HAS COMPLETED SUCCESSFULLY|DATACHECK.*SUCCESSFUL|COMPLETED THE DATACHECK" \
  "${MSG_FILE}" "${DAT_FILE}" "${STDOUT_FILE}" 2>/dev/null; then
  # Some Abaqus builds phrase success differently; fall back to absence of fatal tokens + zero exit.
  if [ "${ABAQUS_RC}" -ne 0 ]; then
    pass=false
    failure="datacheck_success_token_missing"
  fi
fi
if grep -Eqi "unresolved external|undefined reference|signal 11|SIGSEGV|negative eigenvalue|zero or negative" \
  "${MSG_FILE}" "${DAT_FILE}" "${STDOUT_FILE}" 2>/dev/null; then
  pass=false
  failure="compile_link_or_jacobian_or_signal_failure"
fi
if grep -Eqi "BEGIN ANALYSIS STEP|STEP 1 INCREMENT 1.*CONVERGED" "${MSG_FILE}" "${DAT_FILE}" 2>/dev/null; then
  # Guard against accidental full solve start. Datacheck should not advance analysis increments.
  if grep -Eqi "THE ANALYSIS HAS BEEN COMPLETED" "${MSG_FILE}" "${DAT_FILE}" 2>/dev/null && \
     ! grep -Eqi "DATACHECK" "${MSG_FILE}" "${DAT_FILE}" "${STDOUT_FILE}" 2>/dev/null; then
    pass=false
    failure="full_solver_analysis_detected"
  fi
fi

if [ "${pass}" = true ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H0_DATACHECK_STATUS.json" <<EOF
{
  "MODE_II_H0_DATACHECK_ok": true,
  "classification": "stage_f_mode_ii_h0_datacheck_pass",
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "pbs_exit_status": ${ABAQUS_RC},
  "solver_analysis_started": false,
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  : > "${SCRATCH_RUN}/MODE_II_H0_DATACHECK.ok"
  copy_evidence
  exit 0
fi

write_status "stage_f_mode_ii_h0_datacheck_fail" "${ABAQUS_RC}" "${failure}"
copy_evidence
exit 12
