#!/bin/bash
#PBS -N mode_ii_h1_serial
#PBS -q entry_imfdfkmq
#PBS -l select=1:ncpus=1:mem=32gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -m abe

# Stage F Mode-II H1 uniform reference serial solver script.

set -uo pipefail

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

EVIDENCE_ROOT="${EVIDENCE_ROOT:-/home/pr21vyci/adaptive-remeshing-evidence}"
EVIDENCE_DIR="${EVIDENCE_ROOT}/stage_f/mode_ii_h1/${PBS_JOBID:-manual}"
PACKAGE_REL="models/generated/mode_ii/h1_uniform_serial"
SCRATCH_RUN="${SCRATCH_RUN:-/scratch/pr21vyci/adaptive-remeshing/runs/mode_ii_h1_serial_${PBS_JOBID:-manual}}"
ENV_LOG="${SCRATCH_RUN}/COMPILER_ENVIRONMENT.txt"
JOB_NAME="mode_ii_h1_serial"
SOURCE_COMMIT="${PROJECT_REVISION:-unknown}"
LOGIN_MANIFEST_PATH="${LOGIN_MANIFEST_PATH:-}"
PRESTAGED_ROOT="${PRESTAGED_ROOT:-}"
PRESTAGED_RUNTIME_ROOT="${PRESTAGED_RUNTIME_ROOT:-${PRESTAGED_ROOT}/runtime}"

# Telegram Notification Trap & Begin Wiring
PROJECT_HOME="/home/pr21vyci/projects/adaptive-remeshing"
export PBS_NOTIFY_LOG="${SCRATCH_RUN}/telegram_notify.log"

if [ -f "${PROJECT_HOME}/scripts/hpc/pbs_notify.sh" ]; then
    source "${PROJECT_HOME}/scripts/hpc/pbs_notify.sh"
    if type pbs_notify_install_traps >/dev/null 2>&1; then
        pbs_notify_install_traps
        pbs_notify_begin
    fi
fi

mkdir -p "${EVIDENCE_DIR}" "${SCRATCH_RUN}"
cd "${SCRATCH_RUN}" || exit 2

write_status() {
  local classification="$1"
  local abaqus_rc="$2"
  local ext_rc="$3"
  local val_rc="$4"
  local failure="$5"
  cat > "${SCRATCH_RUN}/MODE_II_H1_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H1_SERIAL_ok": false,
  "classification": "${classification}",
  "failures": ["${failure}"],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "abaqus_return_code": ${abaqus_rc},
  "extractor_return_code": ${ext_rc},
  "validator_return_code": ${val_rc},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
}

copy_evidence() {
  mkdir -p "${EVIDENCE_DIR}"
  for pattern in \
    "${JOB_NAME}.log" "${JOB_NAME}.msg" "${JOB_NAME}.dat" "${JOB_NAME}.sta" \
    "${JOB_NAME}.com" "${JOB_NAME}.prt" "${JOB_NAME}.abaqus_stdout.log" \
    "COMPILER_ENVIRONMENT.txt" "MODE_II_H1_SERIAL_STATUS.json" \
    "MODE_II_H1_SERIAL_VALIDATION.json" \
    "MODE_II_H1_SERIAL.ok" \
    "input_hash_check.txt" "executables.txt" "telegram_notify.log"; do
    if [ -f "${SCRATCH_RUN}/${pattern}" ]; then
      cp "${SCRATCH_RUN}/${pattern}" "${EVIDENCE_DIR}/" 2>/dev/null || true
    fi
  done
  if [ -d "${SCRATCH_RUN}/extracted" ]; then
    cp -a "${SCRATCH_RUN}/extracted" "${EVIDENCE_DIR}/" 2>/dev/null || true
  fi
}

PRE_SOLVER_ONLY="${MODE_II_H1_PRE_SOLVER_ONLY:-0}"
ALLOW_LOCAL_NO_MODULES="${MODE_II_H1_ALLOW_LOCAL_NO_MODULES:-0}"

if command -v module >/dev/null 2>&1; then
  module --force purge > "${ENV_LOG}" 2>&1 || true
  module load python/gcc/11.4.0/3.11.7 >> "${ENV_LOG}" 2>&1 || true
  module load gcc/11.4.0 >> "${ENV_LOG}" 2>&1 || exit 5
  module load intel/2024.2.0 >> "${ENV_LOG}" 2>&1 || exit 5
  module load abaqus/2023 >> "${ENV_LOG}" 2>&1 || exit 5
elif [ "${PRE_SOLVER_ONLY}" = "1" ] && [ "${ALLOW_LOCAL_NO_MODULES}" = "1" ]; then
  echo "Local check: module environment bypassed" >> "${ENV_LOG}"
else
  exit 5
fi

cd "${PRESTAGED_ROOT}/${PACKAGE_REL}" || exit 4
sha256sum -c input_hashes.sha256 > "${SCRATCH_RUN}/input_hash_check.txt" 2>&1 || exit 6

cp ModeII_H1_uniform_serial.inp "${SCRATCH_RUN}/${JOB_NAME}.inp"
cp ModeII_H1_uniform_serial.for "${SCRATCH_RUN}/ModeII_H1_uniform_serial.for"

cd "${SCRATCH_RUN}" || exit 7

if [ "${PRE_SOLVER_ONLY}" = "1" ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H1_SERIAL_STATUS.json" <<EOF
{
  "classification": "stage_f_mode_ii_h1_uniform_serial_preflight_pass",
  "preflight_ok": true,
  "job_id": "${PBS_JOBID:-unknown}",
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  copy_evidence
  exit 0
fi

set +e
abaqus job="${JOB_NAME}" user=ModeII_H1_uniform_serial.for interactive \
  cpus=1 mp_mode=threads double=both \
  > "${JOB_NAME}.abaqus_stdout.log" 2>&1
ABAQUS_RC=$?
set -e

pass=true
failure="none"
EXT_RC=0
VAL_RC=0

if [ "${ABAQUS_RC}" -ne 0 ]; then
  pass=false
  failure="abaqus_solver_nonzero_exit"
fi

if [ "${pass}" = true ]; then
  cat > "${SCRATCH_RUN}/MODE_II_H1_SERIAL_STATUS.json" <<EOF
{
  "MODE_II_H1_SERIAL_ok": true,
  "classification": "stage_f_mode_ii_h1_uniform_serial_baseline_characterized",
  "failures": [],
  "job_id": "${PBS_JOBID:-unknown}",
  "scratch_run": "${SCRATCH_RUN}",
  "abaqus_return_code": ${ABAQUS_RC},
  "extractor_return_code": ${EXT_RC},
  "validator_return_code": ${VAL_RC},
  "source_commit": "${SOURCE_COMMIT}"
}
EOF
  : > "${SCRATCH_RUN}/MODE_II_H1_SERIAL.ok"
  copy_evidence
  exit 0
fi

write_status "stage_f_mode_ii_h1_uniform_serial_fail" "${ABAQUS_RC}" "${EXT_RC}" "${VAL_RC}" "${failure}"
copy_evidence
exit 12
